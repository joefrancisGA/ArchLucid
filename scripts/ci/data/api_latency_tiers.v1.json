{
  "version": 1,
  "description": "Machine-readable API latency tiers sourced from docs/library/LONG_RUNNING_OPERATIONS_CONTRACT.md (TB-2079).",
  "routes": [
    {
      "id": "health-live",
      "method": "GET",
      "pathTemplate": "/health/live",
      "tier": "A",
      "notes": "Keep sync"
    },
    {
      "id": "health-ready",
      "method": "GET",
      "pathTemplate": "/health/ready",
      "tier": "A",
      "notes": "Keep sync"
    },
    {
      "id": "reviews-list",
      "method": "GET",
      "pathTemplate": "/v1/architecture/reviews",
      "tier": "B",
      "notes": "List/get stay sync"
    },
    {
      "id": "review-get",
      "method": "GET",
      "pathTemplate": "/v1/architecture/review/{runId}",
      "tier": "B",
      "notes": "List/get stay sync"
    },
    {
      "id": "architecture-request",
      "method": "POST",
      "pathTemplate": "/v1/architecture/request",
      "tier": "C",
      "syncAllowedForSimulator": true,
      "asyncSiblingId": "architecture-request-async",
      "notes": "Sync OK for Simulator/CI; Real-mode clients must use async sibling"
    },
    {
      "id": "architecture-request-async",
      "method": "POST",
      "pathTemplate": "/v1/architecture/request/async",
      "tier": "C",
      "requiresAccepted202": true,
      "requiresAsyncRequiredAttribute": true,
      "notes": "Tier C async create accept"
    },
    {
      "id": "execute-sync",
      "method": "POST",
      "pathTemplate": "/v1/architecture/review/{runId}/execute",
      "tier": "C",
      "syncAllowedForSimulator": true,
      "asyncSiblingId": "execute-async",
      "notes": "Keep sync for Simulator/CI; Real-mode clients must use async sibling"
    },
    {
      "id": "execute-selective-sync",
      "method": "POST",
      "pathTemplate": "/v1/architecture/review/{runId}/execute/selective",
      "tier": "C",
      "syncAllowedForSimulator": true,
      "notes": "Selective execute remains sync for Simulator/CI"
    },
    {
      "id": "execute-async",
      "method": "POST",
      "pathTemplate": "/v1/architecture/review/{runId}/execute/async",
      "tier": "C",
      "requiresAccepted202": true,
      "requiresAsyncRequiredAttribute": true,
      "notes": "TB-2075 async accept"
    },
    {
      "id": "replay-sync",
      "method": "POST",
      "pathTemplate": "/v1/architecture/review/{runId}/replay",
      "tier": "C",
      "syncAllowedForSimulator": true,
      "asyncSiblingId": "replay-async",
      "notes": "Keep sync for Simulator/CI"
    },
    {
      "id": "replay-async",
      "method": "POST",
      "pathTemplate": "/v1/architecture/review/{runId}/replay/async",
      "tier": "C",
      "requiresAccepted202": true,
      "requiresAsyncRequiredAttribute": true,
      "notes": "TB-2075 async accept"
    },
    {
      "id": "analysis-report-docx-async",
      "method": "POST",
      "pathTemplate": "/v1/architecture/run/{runId}/analysis-report/export/docx/async",
      "tier": "D",
      "requiresAccepted202": true,
      "requiresAsyncRequiredAttribute": true,
      "notes": "Background export enqueue"
    },
    {
      "id": "analysis-report-docx-consulting-async",
      "method": "POST",
      "pathTemplate": "/v1/architecture/run/{runId}/analysis-report/export/docx/consulting/async",
      "tier": "D",
      "requiresAccepted202": true,
      "requiresAsyncRequiredAttribute": true,
      "notes": "Background consulting export enqueue"
    },
    {
      "id": "architecture-request-draft",
      "method": "POST",
      "pathTemplate": "/v1/architecture/request/draft",
      "tier": "C",
      "syncAllowedForSimulator": true,
      "asyncSiblingId": "architecture-request-draft-async",
      "notes": "Structured-brief suggest; browser UI uses async sibling"
    },
    {
      "id": "architecture-request-draft-async",
      "method": "POST",
      "pathTemplate": "/v1/architecture/request/draft/async",
      "tier": "C",
      "requiresAccepted202": true,
      "requiresAsyncRequiredAttribute": true,
      "notes": "Async structured-brief suggest accept"
    }
  ],
  "tierCSyncPathAllowlist": [
    "POST /v1/architecture/request",
    "POST /v1/architecture/request/draft",
    "POST /v1/architecture/review/{runId}/execute",
    "POST /v1/architecture/review/{runId}/execute/selective",
    "POST /v1/architecture/review/{runId}/replay"
  ]
}

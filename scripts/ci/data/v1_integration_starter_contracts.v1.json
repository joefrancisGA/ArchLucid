{
  "schema": "archlucid.v1-integration-starter-contracts.v1",
  "effectiveUtc": "2026-06-07T00:00:00Z",
  "description": "Sanitized V1 REST/CLI integration starter contracts for buyer automation paths. Paths are validated against the OpenAPI snapshot; bodies are shape examples only (no secrets).",
  "docRefs": [
    "docs/library/API_CONTRACTS.md",
    "docs/library/CLI_USAGE.md",
    "docs/library/LIVE_E2E_HAPPY_PATH.md",
    "docs/runbooks/CI_GOVERNANCE_GATE.md"
  ],
  "workflows": [
    {
      "id": "review-lifecycle",
      "label": "Create request, execute, commit",
      "cliHints": [
        "archlucid architecture request",
        "archlucid architecture execute <runId>",
        "archlucid architecture commit <runId>"
      ],
      "steps": [
        {
          "id": "create-request",
          "method": "POST",
          "path": "/v1/architecture/request",
          "expectedSuccessStatuses": [200, 201],
          "responseShape": "ArchitectureRun",
          "requestShapeExample": {
            "systemName": "claims-intake-modernization",
            "projectId": "default",
            "description": "Integration starter — sanitized example only"
          },
          "errorSemantics": [
            {
              "status": 400,
              "meaning": "Validation failure — empty or malformed body"
            },
            {
              "status": 401,
              "meaning": "Missing or invalid Bearer/API key auth"
            }
          ]
        },
        {
          "id": "execute-run",
          "method": "POST",
          "path": "/v1/architecture/review/{runId}/execute",
          "expectedSuccessStatuses": [200, 202],
          "responseShape": "ArchitectureRun",
          "errorSemantics": [
            {
              "status": 404,
              "meaning": "Unknown runId or tenant scope mismatch"
            },
            {
              "status": 409,
              "meaning": "Run not in an executable state"
            }
          ]
        },
        {
          "id": "poll-run",
          "method": "GET",
          "path": "/v1/architecture/review/{runId}",
          "expectedSuccessStatuses": [200],
          "responseShape": "ArchitectureRun",
          "pollUntil": {
            "field": "status",
            "values": ["ReadyForCommit", "Committed"]
          }
        },
        {
          "id": "commit-run",
          "method": "POST",
          "path": "/v1/architecture/review/{runId}/finalize",
          "expectedSuccessStatuses": [200],
          "responseShape": "CommitRunResponse",
          "errorSemantics": [
            {
              "status": 400,
              "meaning": "Run not ready for commit or governance block"
            }
          ]
        }
      ]
    },
    {
      "id": "artifacts-retrieval",
      "label": "Export committed run artifacts",
      "dependsOn": "review-lifecycle",
      "steps": [
        {
          "id": "export-zip",
          "method": "GET",
          "path": "/v1/artifacts/runs/{runId}/export",
          "expectedSuccessStatuses": [200],
          "responseShape": "application/zip",
          "errorSemantics": [
            {
              "status": 404,
              "meaning": "Run not found or not committed"
            }
          ]
        }
      ]
    },
    {
      "id": "compare-runs",
      "label": "Compare two committed runs",
      "dependsOn": "review-lifecycle",
      "steps": [
        {
          "id": "compare-runs-query",
          "method": "GET",
          "path": "/v1/authority/compare/runs",
          "expectedSuccessStatuses": [200],
          "queryParameters": ["leftRunId", "rightRunId"],
          "responseShape": "RunComparisonResponse",
          "errorSemantics": [
            {
              "status": 404,
              "meaning": "One or both run ids not found"
            }
          ]
        }
      ]
    },
    {
      "id": "pre-commit-governance-gate",
      "label": "Simulate or commit pre-commit governance gate",
      "cliHints": [
        "curl POST /v1/governance/pre-finalize/simulate",
        "curl POST /v1/architecture/review/{runId}/finalize"
      ],
      "steps": [
        {
          "id": "simulate-pre-commit",
          "method": "POST",
          "path": "/v1/governance/pre-finalize/simulate",
          "expectedSuccessStatuses": [200],
          "responseShape": "PreCommitGateResult",
          "requestShapeExample": {
            "runId": "00000000-0000-0000-0000-000000000001",
            "syntheticSeverity": "Critical",
            "syntheticCount": 1
          },
          "errorSemantics": [
            {
              "status": 400,
              "meaning": "Invalid runId or simulation parameters"
            },
            {
              "status": 404,
              "meaning": "Run not found in tenant scope"
            }
          ],
          "claimBoundary": "Dry-run only — does not commit golden manifest; audit GovernancePreCommitSimulationEvaluated"
        },
        {
          "id": "commit-with-gate",
          "method": "POST",
          "path": "/v1/architecture/review/{runId}/finalize",
          "expectedSuccessStatuses": [200],
          "responseShape": "CommitRunResponse",
          "optional": true,
          "errorSemantics": [
            {
              "status": 409,
              "typeFragment": "governance-pre-commit-blocked",
              "meaning": "PreCommitGateResult block — extensions.blockingFindingIds per API_ERROR_CONTRACT.md"
            }
          ]
        }
      ]
    },
    {
      "id": "roi-summary",
      "label": "Per-run ROI summary",
      "dependsOn": "review-lifecycle",
      "steps": [
        {
          "id": "run-roi",
          "method": "GET",
          "path": "/v1/architecture/review/{runId}/roi",
          "expectedSuccessStatuses": [200],
          "responseShape": "RunRoiSummaryResponse",
          "claimBoundary": "Estimates only — not invoiced Azure OpenAI spend; sponsor-safe SEND requires baselineCompletenessStatus per QUOTE_TO_PROOF_PACKET.md#roi-baseline-send-policy"
        },
        {
          "id": "analytics-roi",
          "method": "GET",
          "path": "/v1/analytics/roi",
          "expectedSuccessStatuses": [200],
          "responseShape": "SponsorRoiSummaryResponse",
          "optional": true,
          "claimBoundary": "Aggregate analytics — requires sufficient committed runs and configured baseline inputs"
        }
      ]
    }
  ],
  "deferredConnectorsV1_1": [
    "ServiceNow",
    "Confluence/Jira",
    "Slack",
    "Microsoft Teams (first buyer-critical V1.1 target after core V1 proof)"
  ],
  "v1AutomationHandoffNote": "V1 automation uses REST, CLI, UI export, and SCIM. First-party ITSM/docs/chat connectors are V1.1 — see deferredConnectorsV1_1."
}

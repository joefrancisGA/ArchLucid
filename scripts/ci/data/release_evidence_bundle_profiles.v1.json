    "production-readiness-drill": {
      "description": "Timestamped drill folder from production-readiness-drill.ps1",
      "requiredFiles": [
        "drill-summary.json",
        "drill-summary.md"
      ],
      "requiredPatterns": [
        {
          "pattern": "config-lint/config-lint-production-like-hosted-pilot.json",

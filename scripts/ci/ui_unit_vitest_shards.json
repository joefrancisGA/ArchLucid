{
  "shards": [
    {
      "id": "lib",
      "label": "lib (1/5)",
      "paths": ["src/lib"]
    },
    {
      "id": "components",
      "label": "components (2/5)",
      "paths": ["src/components"]
    },
    {
      "id": "app-operator",
      "label": "app-operator (3/5)",
      "paths": ["src/app/(operator)"]
    },
    {
      "id": "app-marketing",
      "label": "app-marketing (4/5)",
      "paths": ["src/app/(marketing)"]
    },
    {
      "id": "surface",
      "label": "surface (5/5)",
      "paths": [
        "src/accessibility",
        "src/hooks",
        "src/integration",
        "src/marketing",
        "src/review-workflow",
        "src/data",
        "scripts",
        "src/next.config.*.test.ts"
      ]
    }
  ]
}

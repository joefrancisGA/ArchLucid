    db.query.text: UPDATE dbo.Tenants
SET TrialStartUtc = @TrialStartUtc,
    TrialExpiresUtc = @TrialExpiresUtc,
    TrialRunsLimit = @TrialRunsLimit,
    TrialRunsUsed = ?,
    TrialSeatsLimit = @TrialSeatsLimit,

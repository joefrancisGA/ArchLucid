    db.namespace: ArchLucidGreenfield_9ef5bd0a0e54421dbcfc23cb67e30e6e
    server.address: 127.0.0.1
    db.query.text: SELECT CAST(? AS BIGINT) AS TokensConsumed,
       CAST(? AS BIGINT) AS ReservedTokens,
       SpentUsd AS CommittedUsd,
       ReservedAssumedUsd AS ReservedUsd,
       PurchasedCapBumpUsd AS PurchasedCapBumpUsd,
       WarnedApproaching,
       RowVersion
FROM dbo.LlmMonthlyTenantBudgetState
WHERE TenantId = @TenantId AND UtcYear = @UtcYear AND UtcMonth = @UtcMonth;
    db.query.summary: SELECT dbo.LlmMonthlyTenantBudgetState

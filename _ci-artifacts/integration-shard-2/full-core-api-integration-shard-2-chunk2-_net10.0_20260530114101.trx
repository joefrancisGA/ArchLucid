Activity.StartTime:          2026-05-30T11:40:26.9174502Z
Activity.Duration:           00:00:00.0161931
Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_74bc999e24dc4d58aae0eb5ce573f9ad
    server.address: 127.0.0.1
    db.query.text: SELECT COUNT_BIG(?)
FROM dbo.Runs r
WHERE r.ArchivedUtc IS NULL
  AND r.ArchitectureRequestId IS NOT NULL
  AND LEN(LTRIM(RTRIM(r.ArchitectureRequestId))) &gt; ?
  AND NOT EXISTS (
      SELECT ?
      FROM dbo.ArchitectureRequests a
      WHERE a.RequestId = r.ArchitectureRequestId);
    db.query.summary: SELECT dbo.Runs

Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_9ef5bd0a0e54421dbcfc23cb67e30e6e
    server.address: 127.0.0.1
    db.query.text: SELECT COUNT_BIG(?)
FROM dbo.Runs r
WHERE r.ArchivedUtc IS NULL
  AND r.GoldenManifestId IS NOT NULL
  AND NOT EXISTS (
      SELECT ?
      FROM dbo.GoldenManifests m
      WHERE m.ManifestId = r.GoldenManifestId
        AND m.RunId = r.RunId);
    db.query.summary: SELECT dbo.Runs

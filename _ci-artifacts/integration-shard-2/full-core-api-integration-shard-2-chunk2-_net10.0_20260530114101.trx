    server.address: 127.0.0.1
    db.query.text: SELECT COUNT_BIG(?)
FROM (
    SELECT ? AS StallKind
    FROM dbo.AgentTasks AS t
    INNER JOIN dbo.Runs AS r
        ON TRY_CAST(t.RunId AS UNIQUEIDENTIFIER) = r.RunId
    WHERE r.ArchivedUtc IS NULL
      AND t.Status = ?
      AND t.CreatedUtc &lt; DATEADD(HOUR, -@StallHours, SYSUTCDATETIME())
    UNION ALL
    SELECT ? AS StallKind
    FROM dbo.AuthorityPipelineWorkOutbox AS o
    WHERE o.ProcessedUtc IS NULL
      AND o.CreatedUtc &lt; DATEADD(HOUR, -@StallHours, SYSUTCDATETIME())
) AS stalled;
    db.query.summary: SELECT dbo.Runs

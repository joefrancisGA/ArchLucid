Activity.DisplayName:        SELECT SELECT dbo.FindingsSnapshots SELECT dbo.AlertRecords
Activity.Kind:               Client
Activity.StartTime:          2026-05-30T11:40:32.3459427Z
Activity.Duration:           00:00:00.0005744
Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_74bc999e24dc4d58aae0eb5ce573f9ad
    server.address: 127.0.0.1
    db.query.text: SELECT
    RunId, TenantId, WorkspaceId, ScopeProjectId, ProjectId, Description, CreatedUtc,
    ContextSnapshotId, GraphSnapshotId, FindingsSnapshotId,
    GoldenManifestId, DecisionTraceId, ArtifactBundleId, ArchivedUtc,
    ArchitectureRequestId, LegacyRunStatus, CompletedUtc, CurrentManifestVersion, OtelTraceId,
    IsDemoWelcomeRun, IsPublicShowcase, IsSample, IsPinned, RealModeFellBackToSimulator, PilotAoaiDeploymentSnapshot,
    StructuralExecutionMode,
    RetryCount, LastFailureReason,
    RowVersionStamp AS RowVersion,
    CASE WHEN EXISTS (SELECT ? FROM dbo.FindingsSnapshots fs WITH (NOLOCK) WHERE fs.RunId = dbo.Runs.RunId AND fs.ArchivedUtc IS NULL AND fs.HasWarnings = ?) THEN ? ELSE ? END AS HasWarnings,
    CASE WHEN EXISTS (SELECT ? FROM dbo.AlertRecords ar WITH (NOLOCK) WHERE ar.RunId = dbo.Runs.RunId AND ar.Status = ?) THEN ? ELSE ? END AS HasGovernanceWarnings
FROM dbo.Runs
WHERE RunId = @RunId
  AND TenantId = @TenantId
  AND WorkspaceId = @WorkspaceId
  AND ScopeProjectId = @ScopeProjectId
  AND ArchivedUtc IS NULL;
    db.query.summary: SELECT SELECT dbo.FindingsSnapshots SELECT dbo.AlertRecords

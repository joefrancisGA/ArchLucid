    CompanySize = @CompanySize,
    ArchitectureTeamSize = @ArchitectureTeamSize,
    IndustryVertical = @IndustryVertical,
    IndustryVerticalOther = @IndustryVerticalOther
WHERE Id = @Id;
    db.query.summary: UPDATE

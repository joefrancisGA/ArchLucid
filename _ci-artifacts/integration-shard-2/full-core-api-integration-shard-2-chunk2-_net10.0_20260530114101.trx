Activity.DisplayName:        SELECT dbo.AuthorityPipelineWorkOutbox
Activity.Kind:               Client
Activity.StartTime:          2026-05-30T11:40:43.0115762Z
Activity.Duration:           00:00:00.0139827
Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_9ef5bd0a0e54421dbcfc23cb67e30e6e
    server.address: 127.0.0.1
    db.query.text: SELECT COUNT_BIG(?) AS Cnt, MIN(CreatedUtc) AS OldestUtc
FROM dbo.AuthorityPipelineWorkOutbox
WHERE ProcessedUtc IS NULL
  AND DeadLetteredUtc IS NULL
  AND (NextAttemptUtc IS NULL OR NextAttemptUtc &lt;= SYSUTCDATETIME())
  AND (LockedUntilUtc IS NULL OR LockedUntilUtc &lt;= SYSUTCDATETIME());
SELECT COUNT_BIG(?) AS Cnt
FROM dbo.AuthorityPipelineWorkOutbox
WHERE DeadLetteredUtc IS NOT NULL
  AND ProcessedUtc IS NULL;
SELECT COUNT_BIG(?) AS Cnt, MIN(CreatedUtc) AS OldestUtc
FROM dbo.RetrievalIndexingOutbox
WHERE ProcessedUtc IS NULL
  AND DeadLetteredUtc IS NULL
  AND (NextAttemptUtc IS NULL OR NextAttemptUtc &lt;= SYSUTCDATETIME())
  AND (LockedUntilUtc IS NULL OR LockedUntilUtc &lt;= SYSUTCDATETIME());
SELECT COUNT_BIG(?) AS Cnt
FROM dbo.RetrievalIndexingOutbox
WHERE DeadLetteredUtc IS NOT NULL
  AND ProcessedUtc IS NULL;
SELECT COUNT_BIG(?) AS Cnt, MIN(CreatedUtc) AS OldestUtc
FROM dbo.IntegrationEventOutbox
WHERE ProcessedUtc IS NULL
  AND DeadLetteredUtc IS NULL
  AND (NextRetryUtc IS NULL OR NextRetryUtc &lt;= SYSUTCDATETIME());
SELECT COUNT_BIG(?) AS Cnt
FROM dbo.IntegrationEventOutbox
WHERE DeadLetteredUtc IS NOT NULL
  AND ProcessedUtc IS NULL;
    db.query.summary: SELECT dbo.AuthorityPipelineWorkOutbox

Resource associated with Activity:
    service.name: ArchLucid.Api
    service.version: 1.0.0+7746bd47063c80aea9eb0cd4fd6b09885c88334a
    service.instance.id: runnervm3jyl0
    telemetry.sdk.name: opentelemetry
    telemetry.sdk.language: dotnet
    telemetry.sdk.version: 1.15.3
Activity.TraceId:            82d5b583da4d3eefcc944621f874b621
Activity.SpanId:             9ab5d5d3f77c0793
Activity.TraceFlags:         Recorded
Activity.DisplayName:        SELECT dbo.RetrievalIndexingOutbox cte
Activity.Kind:               Client
Activity.StartTime:          2026-05-30T11:40:30.9347871Z
Activity.Duration:           00:00:00.0490663
Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_74bc999e24dc4d58aae0eb5ce573f9ad
    server.address: 127.0.0.1
    db.query.text: ;WITH cte AS (
    SELECT TOP (@Take)
        OutboxId
    FROM dbo.RetrievalIndexingOutbox WITH (READPAST, UPDLOCK, ROWLOCK)
    WHERE ProcessedUtc IS NULL
      AND DeadLetteredUtc IS NULL
      AND (NextAttemptUtc IS NULL OR NextAttemptUtc &lt;= SYSUTCDATETIME())
      AND (LockedUntilUtc IS NULL OR LockedUntilUtc &lt;= SYSUTCDATETIME())
    ORDER BY CreatedUtc ASC, OutboxId ASC)
UPDATE o
    SET LockedUntilUtc = DATEADD(second, @LeaseSeconds, SYSUTCDATETIME())
OUTPUT inserted.OutboxId,
       inserted.RunId,
       inserted.TenantId,
       inserted.WorkspaceId,
       inserted.ProjectId,
       inserted.CreatedUtc,
       inserted.AttemptCount,
       inserted.LockedUntilUtc,
       inserted.NextAttemptUtc,
       inserted.LastAttemptError,
       inserted.DeadLetteredUtc
    FROM dbo.RetrievalIndexingOutbox AS o
    INNER JOIN cte ON cte.OutboxId = o.OutboxId;
    db.query.summary: SELECT dbo.RetrievalIndexingOutbox cte
Instrumentation scope (ActivitySource):
    Name: OpenTelemetry.Instrumentation.SqlClient
    Version: 1.15.1
    Schema URL: https://opentelemetry.io/schemas/1.33.0
Resource associated with Activity:
    service.name: ArchLucid.Api
    service.version: 1.0.0+7746bd47063c80aea9eb0cd4fd6b09885c88334a
    service.instance.id: runnervm3jyl0
    telemetry.sdk.name: opentelemetry
    telemetry.sdk.language: dotnet
    telemetry.sdk.version: 1.15.3
Activity.TraceId:            0e7dd1817a2c6bcb2e1331c22f1ee3a2
Activity.SpanId:             0d1cfe6a8b650f13
Activity.TraceFlags:         Recorded
Activity.DisplayName:        SELECT dbo.AuthorityPipelineWorkOutbox cte
Activity.Kind:               Client
Activity.StartTime:          2026-05-30T11:40:30.9253648Z
Activity.Duration:           00:00:00.0016600
Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_74bc999e24dc4d58aae0eb5ce573f9ad
    server.address: 127.0.0.1
    db.query.text: ;WITH numbered AS (
    SELECT
        o.OutboxId,
        o.TenantId,
        o.CreatedUtc,
        ROW_NUMBER() OVER (
            PARTITION BY o.TenantId
            ORDER BY o.CreatedUtc ASC, o.OutboxId ASC) AS TenantSeq
    FROM dbo.AuthorityPipelineWorkOutbox AS o WITH (READPAST, UPDLOCK, ROWLOCK)
    WHERE o.ProcessedUtc IS NULL
      AND o.DeadLetteredUtc IS NULL
      AND (o.NextAttemptUtc IS NULL OR o.NextAttemptUtc &lt;= SYSUTCDATETIME())
      AND (o.LockedUntilUtc IS NULL OR o.LockedUntilUtc &lt;= SYSUTCDATETIME())),
cte AS (
    SELECT TOP (@Take)
        n.OutboxId
    FROM numbered AS n
    ORDER BY n.TenantSeq ASC, n.TenantId ASC, n.CreatedUtc ASC, n.OutboxId ASC)
UPDATE o
    SET LockedUntilUtc = DATEADD(second, @LeaseSeconds, SYSUTCDATETIME())
OUTPUT inserted.OutboxId,
       inserted.RunId,
       inserted.TenantId,
       inserted.WorkspaceId,
       inserted.ProjectId,
       inserted.PayloadJson,
       inserted.CreatedUtc,
       inserted.AttemptCount,
       inserted.LockedUntilUtc,
       inserted.NextAttemptUtc,
       inserted.LastAttemptError,
       inserted.DeadLetteredUtc
    FROM dbo.AuthorityPipelineWorkOutbox AS o
    INNER JOIN cte ON cte.OutboxId = o.OutboxId;
    db.query.summary: SELECT dbo.AuthorityPipelineWorkOutbox cte

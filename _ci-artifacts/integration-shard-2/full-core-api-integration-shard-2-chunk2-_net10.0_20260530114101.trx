Activity.DisplayName:        SELECT dbo.FindingRecords dbo.FindingsSnapshots
Activity.Kind:               Client
Activity.StartTime:          2026-05-30T11:40:43.1300418Z
Activity.Duration:           00:00:00.0368573
Activity.Tags:
    db.system.name: microsoft.sql_server
    db.namespace: ArchLucidGreenfield_9ef5bd0a0e54421dbcfc23cb67e30e6e
    server.address: 127.0.0.1
    db.query.text: SELECT TOP (@MaxSample)
       fr.FindingId,
       fr.Title,
       fr.Category,
       fr.TenantId,
       fs.CreatedUtc AS SnapshotCreatedUtc
FROM dbo.FindingRecords AS fr WITH (NOLOCK)
INNER JOIN dbo.FindingsSnapshots AS fs WITH (NOLOCK) ON fs.FindingsSnapshotId = fr.FindingsSnapshotId
WHERE fs.CreatedUtc &gt;= @CutoffUtc
  AND fs.ArchivedUtc IS NULL
  AND fr.Severity = @Severity
ORDER BY fs.CreatedUtc DESC,
         fr.SortOrder ASC;
    db.query.summary: SELECT dbo.FindingRecords dbo.FindingsSnapshots

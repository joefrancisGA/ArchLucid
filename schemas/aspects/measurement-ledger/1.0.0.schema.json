{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.archlucid.com/aspects/measurement-ledger/1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "measurementId",
    "repository",
    "headCommit",
    "history",
    "coverage",
    "defects",
    "evidence",
    "density",
    "warning"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "measurementId": {
      "type": "string",
      "format": "uuid"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "headCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traversal",
        "windowCommits"
      ],
      "properties": {
        "traversal": {
          "const": "first-parent"
        },
        "windowCommits": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "uniquePathBlobLines",
        "reviewedFileCount",
        "newlyReviewedFileCount"
      ],
      "properties": {
        "method": {
          "const": "path-blob-interval-union"
        },
        "uniquePathBlobLines": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "newlyReviewedFileCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "defects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinctConfirmed",
        "verifiedFixes",
        "repeatDiscoveries",
        "possibleDuplicates"
      ],
      "properties": {
        "distinctConfirmed": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedFixes": {
          "type": "integer",
          "minimum": 0
        },
        "repeatDiscoveries": {
          "type": "integer",
          "minimum": 0
        },
        "possibleDuplicates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerRef",
        "sourceBaselineRefs",
        "verificationStatus"
      ],
      "properties": {
        "ledgerRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceBaselineRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "verificationStatus": {
          "enum": [
            "verified-subset",
            "provisional",
            "unavailable"
          ]
        }
      }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valuePerKloc",
        "denominatorKind"
      ],
      "properties": {
        "valuePerKloc": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "denominatorKind": {
          "const": "unique-path-blob-lines"
        },
        "priorValuePerKloc": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "deltaPerKloc": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "warning": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "uniquePathBlobLines": {
                "const": 0
              }
            },
            "required": [
              "uniquePathBlobLines"
            ]
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "density": {
            "properties": {
              "valuePerKloc": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.archlucid.com/operations/safe-dry-run/1.0.0.json",
  "title": "FND-014 Safe Dry-run Execution Abstraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "proposalRef",
    "evidenceRefs",
    "mode",
    "sideEffectsPermitted",
    "environmentCapabilities",
    "simulatedSteps",
    "outcome",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "proposalRef": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mode": {
      "const": "dry-run"
    },
    "sideEffectsPermitted": {
      "const": false
    },
    "environmentCapabilities": {
      "type": "array",
      "items": {
        "enum": [
          "read-snapshot",
          "simulate-plan",
          "emit-advisory-artifact"
        ]
      },
      "uniqueItems": true
    },
    "simulatedSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "predictedOutcome"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "predictedOutcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "simulated",
        "blocked",
        "inconclusive"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.archlucid.com/extensions/manifest/1.0.0.json",
  "title": "FND-003 extension capability manifest v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "extensionId",
    "extensionVersion",
    "publisher",
    "capabilities",
    "requestedPermissions",
    "executionMode"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1.0.0"
    },
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 128
    },
    "extensionVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "executionMode": {
      "const": "disabled"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "architecture.read",
          "finding.propose",
          "remediation.propose",
          "verification.propose"
        ]
      }
    },
    "requestedPermissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "architecture.read",
          "evidence.read",
          "findings.write-proposal"
        ]
      }
    },
    "minimumHostContract": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 512
    }
  }
}

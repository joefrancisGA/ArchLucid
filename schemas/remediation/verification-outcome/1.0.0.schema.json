{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.archlucid.com/remediation/verification-outcome/1.0.0.json",
  "title": "FND-008 Independent Verification Outcome v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verificationId",
    "tenantId",
    "proposalId",
    "remediationInstanceRef",
    "executionReference",
    "baselineSnapshotRef",
    "verificationSnapshotRef",
    "verificationTime",
    "verifier",
    "outcome",
    "checks",
    "regressions",
    "residualRisk",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "verificationId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "proposalId": {
      "type": "string",
      "format": "uuid"
    },
    "remediationInstanceRef": {
      "type": "string",
      "minLength": 1
    },
    "executionReference": {
      "type": "string",
      "minLength": 1
    },
    "baselineSnapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "verificationSnapshotRef": {
      "type": "string",
      "minLength": 1
    },
    "verificationTime": {
      "type": "string",
      "format": "date-time"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "independent-service",
            "human-reviewer"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "inconclusive"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "severity",
          "evidenceRefs"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "residualRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "rationale"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          },
          "regressions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

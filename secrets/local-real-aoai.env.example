# Copy to secrets/local-real-aoai.env (gitignored) and fill before running:
#   .\scripts\Invoke-RealLlmEvidenceGate.ps1
#
# Use classic Azure OpenAI host form (Foundry project URLs are normalized on load):
#   https://{resource}.openai.azure.com/

ARCHLUCID_REAL_AOAI_TEST_ENDPOINT=https://your-resource.openai.azure.com/
ARCHLUCID_REAL_AOAI_TEST_KEY=your-azure-openai-api-key
ARCHLUCID_REAL_AOAI_TEST_DEPLOYMENT=gpt-4o

# Optional aliases (Import-LocalRealAoaiEnv.ps1 maps these when TEST_* vars are empty):
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

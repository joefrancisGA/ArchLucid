<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArchLucid.Cli.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Humanizer.Core">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArchLucid.Cli\ArchLucid.Cli.csproj" />
    <ProjectReference Include="..\ArchLucid.Core\ArchLucid.Core.csproj" />
    <ProjectReference Include="..\ArchLucid.TestSupport\ArchLucid.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\schemas\*.schema.json" Link="schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\templates\starter-proof-packs\regulated-saas-soc-procurement\second-run.json" Link="templates\starter-proof-packs\regulated-saas-soc-procurement\second-run.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\starter-proof-packs\healthcare-data-workflow\second-run.json" Link="templates\starter-proof-packs\healthcare-data-workflow\second-run.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\starter-proof-packs\azure-cost-governance\second-run.json" Link="templates\starter-proof-packs\azure-cost-governance\second-run.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\starter-proof-packs\ai-llm-workload\second-run.json" Link="templates\starter-proof-packs\ai-llm-workload\second-run.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ArchLucid.Core" />
    <Using Include="ArchLucid.Core.Manifest" />
    <Using Include="ArchLucid.TestSupport" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

<Project>
  <!-- Finding row shapes moved from Decisioning.Models to Contracts (#33 Phase 2e). -->
  <Target Name="ArchLucidAddContractsFindingsGlobalUsings"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'ArchLucid.Contracts' And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceDecisioning.cs')">
    <ItemGroup>
      <_ContractsProjectReference Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('ArchLucid.Contracts.csproj'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_ContractsProjectReference)' != ''">
      <Compile Include="$(MSBuildThisFileDirectory)build\GlobalUsings.ContractsFindings.cs" Link="GlobalUsings.ContractsFindings.cs" />
    </ItemGroup>
  </Target>

  <!-- Governance policy-pack row shapes and persistence ports moved from Decisioning (#33 Phase 2e-c). -->
  <Target Name="ArchLucidAddPersistenceGovernanceGlobalUsings"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'ArchLucid.Contracts' And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceGovernance.cs')">
    <ItemGroup>
      <_CoreProjectReference Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('ArchLucid.Core.csproj'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_CoreProjectReference)' != ''">
      <Compile Include="$(MSBuildThisFileDirectory)build\GlobalUsings.PersistenceGovernance.cs" Link="GlobalUsings.PersistenceGovernance.cs" />
    </ItemGroup>
  </Target>

  <!-- Advisory row shapes and persistence ports moved from Decisioning (#33 Phase 2e-d). -->
  <Target Name="ArchLucidAddPersistenceAdvisoryGlobalUsings"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'ArchLucid.Contracts' And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceAdvisory.cs')">
    <ItemGroup>
      <_CoreProjectReference Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('ArchLucid.Core.csproj'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_CoreProjectReference)' != ''">
      <Compile Include="$(MSBuildThisFileDirectory)build\GlobalUsings.PersistenceAdvisory.cs" Link="GlobalUsings.PersistenceAdvisory.cs" />
    </ItemGroup>
  </Target>

  <!-- Authority orchestration ports moved from Decisioning.Interfaces (#33 Phase 2e-e). -->
  <Target Name="ArchLucidAddPersistenceOrchestrationPortsGlobalUsings"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'ArchLucid.Contracts' And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceDecisioning.cs') And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceOrchestrationPorts.cs')">
    <ItemGroup>
      <_CoreProjectReference Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('ArchLucid.Core.csproj'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_CoreProjectReference)' != ''">
      <Compile Include="$(MSBuildThisFileDirectory)build\GlobalUsings.PersistenceOrchestrationPorts.cs" Link="GlobalUsings.PersistenceOrchestrationPorts.cs" />
    </ItemGroup>
  </Target>

  <!-- Humanizer.Core ships Humanizer.Analyzers (e.g. NamespaceMigrationAnalyzer). Remove from all projects. -->
  <Target Name="ArchLucidRemoveHumanizerAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="$([System.String]::Copy('%(Identity)').IndexOf('Humanizer.Analyzers', System.StringComparison.OrdinalIgnoreCase)) &gt;= 0" />
    </ItemGroup>
  </Target>
  <!-- Reuse existing explicit analyzer references and fill gaps for the other product projects. -->
  <PropertyGroup>
    <_ArchLucidEnumProduct Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('ArchLucid.')) And !$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests')) And '$(MSBuildProjectName)' != 'ArchLucid.Analyzers'">true</_ArchLucidEnumProduct>
  </PropertyGroup>
  <ItemGroup Condition="'$(_ArchLucidEnumProduct)' == 'true'">
    <_ArchLucidExistingAnalyzerReference Include="@(ProjectReference)"
        Condition="'%(ProjectReference.Filename)' == 'ArchLucid.Analyzers'" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)ArchLucid.Analyzers/ArchLucid.Analyzers.csproj"
        OutputItemType="Analyzer" ReferenceOutputAssembly="false"
        Condition="'@(_ArchLucidExistingAnalyzerReference)' == ''" />
    <CompilerVisibleProperty Include="EnumAuditInventory" />
  </ItemGroup>
  <!-- Capture a separate SARIF file during the existing compiler invocation; no second build. -->
  <Target Name="ArchLucidEnumAuditDiagnostics" BeforeTargets="CoreCompile"
          Condition="'$(EnumAuditInventory)' == 'true' and '$(EnumAuditLogDirectory)' != ''">
    <MakeDir Directories="$(EnumAuditLogDirectory)" />
    <PropertyGroup>
      <ErrorLog>$(EnumAuditLogDirectory)/$(MSBuildProjectName)-$(TargetFramework).sarif,version=2.1</ErrorLog>
    </PropertyGroup>
  </Target>
</Project>

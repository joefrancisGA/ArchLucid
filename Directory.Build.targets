<Project>
  <!-- Finding row shapes moved from Decisioning.Models to Contracts (#33 Phase 2e). -->
  <Target Name="ArchLucidAddContractsFindingsGlobalUsings"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'ArchLucid.Contracts' And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceDecisioning.cs')">
    <ItemGroup>
      <_ContractsProjectReference Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('ArchLucid.Contracts.csproj'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_ContractsProjectReference)' != ''">
      <Compile Include="$(MSBuildThisFileDirectory)build\GlobalUsings.ContractsFindings.cs" Link="GlobalUsings.ContractsFindings.cs" />
    </ItemGroup>
  </Target>

  <!-- Governance policy-pack row shapes and persistence ports moved from Decisioning (#33 Phase 2e-c). -->
  <Target Name="ArchLucidAddPersistenceGovernanceGlobalUsings"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'ArchLucid.Contracts' And !Exists('$(MSBuildProjectDirectory)\GlobalUsings.PersistenceGovernance.cs')">
    <ItemGroup>
      <_CoreProjectReference Include="@(ProjectReference)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('ArchLucid.Core.csproj'))" />
    </ItemGroup>
    <ItemGroup Condition="'@(_CoreProjectReference)' != ''">
      <Compile Include="$(MSBuildThisFileDirectory)build\GlobalUsings.PersistenceGovernance.cs" Link="GlobalUsings.PersistenceGovernance.cs" />
    </ItemGroup>
  </Target>

  <!-- Humanizer.Core ships Humanizer.Analyzers (e.g. NamespaceMigrationAnalyzer). Remove from all projects. -->
  <Target Name="ArchLucidRemoveHumanizerAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="$([System.String]::Copy('%(Identity)').IndexOf('Humanizer.Analyzers', System.StringComparison.OrdinalIgnoreCase)) &gt;= 0" />
    </ItemGroup>
  </Target>
</Project>

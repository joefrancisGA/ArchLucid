{
  "schemaVersion": 1,
  "purpose": "TB-410: canonical operator-shell routes probed by ship-gate Gate 5 when --ui-base-url is supplied. Aligns with docs/library/FIRST_HOUR_OPERATOR_PATH.md and operator-first-hour journey spine.",
  "routes": [
    {
      "id": "operator-home",
      "label": "Operator home",
      "pathTemplate": "/"
    },
    {
      "id": "new-review",
      "label": "New architecture request",
      "pathTemplate": "/reviews/new"
    },
    {
      "id": "run-detail",
      "label": "Committed run detail",
      "pathTemplate": "/reviews/{runId}"
    },
    {
      "id": "run-signed-record",
      "label": "Run sealed record",
      "pathTemplate": "/reviews/{runId}/signed-record"
    },
    {
      "id": "signed-records-list",
      "label": "Sealed records list",
      "pathTemplate": "/signed-records"
    },
    {
      "id": "first-review-help",
      "label": "First-review playbook help",
      "pathTemplate": "/help/first-review"
    }
  ],
  "acceptableStatusCodes": [200, 301, 302, 307, 308],
  "errorBoundaryMarkers": [
    "something went wrong",
    "application error: a client-side exception has occurred"
  ]
}

{
  "schemaVersion": 1,
  "purpose": "TB-412/TB-417: canonical committed-run export routes probed by ship-gate Gate 4 (Markdown, DOCX, artifact ZIP, traceability bundle ZIP) on the representative --run-id.",
  "probes": [
    {
      "id": "first-value-markdown",
      "label": "Sponsor first-value Markdown",
      "format": "markdown",
      "method": "GET",
      "pathTemplate": "/v1/pilots/runs/{runId}/first-value-report",
      "expectedContentTypePrefixes": ["text/markdown", "text/plain"],
      "minBodyBytes": 32
    },
    {
      "id": "analysis-report-docx",
      "label": "Analysis report DOCX",
      "format": "docx",
      "method": "POST",
      "pathTemplate": "/v1/architecture/review/{runId}/analysis-report/export/docx",
      "requestBodyJson": "{}",
      "expectedContentTypePrefixes": [
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/octet-stream"
      ],
      "minBodyBytes": 512
    },
    {
      "id": "run-export-zip",
      "label": "Run artifact export ZIP",
      "format": "zip",
      "method": "GET",
      "pathTemplate": "/v1/artifacts/runs/{runId}/export",
      "expectedContentTypePrefixes": ["application/zip", "application/octet-stream"],
      "minBodyBytes": 64,
      "requireZipMagicBytes": true
    },
    {
      "id": "traceability-bundle-zip",
      "label": "Traceability audit hand-off ZIP",
      "format": "traceability-zip",
      "method": "GET",
      "pathTemplate": "/v1/architecture/review/{runId}/traceability-bundle.zip",
      "expectedContentTypePrefixes": ["application/zip", "application/octet-stream"],
      "minBodyBytes": 64,
      "requireZipMagicBytes": true
    }
  ],
  "acceptableStatusCodes": [200]
}

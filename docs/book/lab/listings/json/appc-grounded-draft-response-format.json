{
  "type": "json_schema",
  "json_schema": {
    "name": "grounded_draft",
    "strict": true,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sentences"],
      "properties": {
        "status": { "type": "string", "enum": ["answered", "insufficient_evidence"] },
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "cites"],
            "properties": {
              "text": { "type": "string" },
              "cites": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}

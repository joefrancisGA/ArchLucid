sequenceDiagram
  participant Client
  participant MW as CorrelationIdMiddleware
  participant Parse as CorrelationIdHeaderParser
  participant Act as Activity.Current
  participant Log as HttpRequestLoggingMiddleware
  participant Out as RetrievalIndexingOutbox
  Client->>MW: X-Correlation-Id
  MW->>Parse: validate header
  Parse->>Act: set baggage and tags
  Act->>Log: scope tags
  Act->>Out: ProcessEntry activity

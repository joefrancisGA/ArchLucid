  end

  subgraph stores["Stores"]
    IDX["Vector / search index<br/>tenant-scoped writes"]
    SQL[("Tenant SQL catalog")]
  end

  USER --> SCOPE --> FILTER --> IDX
  FILTER --> SQL
  FILTER --> GROUND
  PROMPT --> GROUND
  BUDGET -.-> GROUND
  CROSS -.->|"blocked by catalog + query filter"| FILTER

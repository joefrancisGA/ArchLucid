    CROSS["Cross-tenant probe"]
    PROMPT["Prompt injection via Ask"]
  end

  subgraph controls["Ask / RAG controls"]
    SCOPE["ScopeContext from identity<br/>not client headers in prod"]
    FILTER["Retrieval filtered to tenant corpus"]
    GROUND["Grounded answers + citations"]

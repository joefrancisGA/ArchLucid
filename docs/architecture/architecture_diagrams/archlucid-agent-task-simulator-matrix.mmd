flowchart TB
  START["POST architecture/request"] --> CHECK{"Authority already finalized?"}
  CHECK -->|Yes| STOP["Do not execute/result"]
  CHECK -->|No| PATH{"Driving AgentTask loop?"}
  PATH -->|No| AUTH["Authority pipeline stages"]
  PATH -->|Yes| TASKS["AgentTasks: topology cost compliance critic"]
  TASKS --> EXEC["POST execute and/or result"]
  EXEC --> READY{"ReadyForCommit + four AgentResults?"}
  READY -->|Yes| FIN["POST finalize merge"]
  READY -->|No| WAIT["Wait / submit missing results"]
  AUTH --> DONE["GoldenManifest in pipeline TX"]
  FIN --> DONE
  subgraph modes["Executor modes"]
    SIM["Simulator"]
    REAL["Real Azure OpenAI"]
  end
  EXEC -.-> modes

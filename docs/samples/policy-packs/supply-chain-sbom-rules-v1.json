      "title": "Source repository branch protection",
      "description": "Main/release branches must document required reviews, status checks, and signed commits.",
      "severity": "High",
      "priority": "P1",
      "remediationGuidance": "Capture branch protection in governance.PolicyConstraints.",
      "evidenceHints": [

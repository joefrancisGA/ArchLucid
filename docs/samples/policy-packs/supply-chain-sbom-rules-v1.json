        "services[].Purpose"
      ],
      "frameworkMappings": [
        {
          "framework": "SLSA / SSDF",
          "theme": "SLSA \u2014 Signed artifacts"
        }
      ]
    },
    {
      "id": "supply-chain-005",
      "title": "SLSA build level target documented",
      "description": "Pipeline should state target SLSA level (1\u20133) and gaps to next level.",
      "severity": "Medium",
      "priority": "P0",
      "remediationGuidance": "Note SLSA level in governance.ComplianceTags.",

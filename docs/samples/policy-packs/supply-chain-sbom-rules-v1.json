{
  "schemaVersion": 1,
  "kind": "archlucid.policyPack.curatedRules.v1",
  "pack": {
    "name": "Software Supply Chain & SBOM",
    "description": "SBOM, artifact signing, and dependency scanning themes for delivery pipelines.",
    "version": "1.1.0",
    "category": "DevSecOps",
    "isDefault": true,
    "suggestedPackType": "PlatformDefault",
    "policyPackContentDocumentPath": "docs/samples/policy-packs/supply-chain-sbom.json"
  },
  "rules": [
    {
      "id": "supply-chain-001",
      "title": "SBOM generated for every release artifact",
      "description": "Build pipelines must produce machine-readable SBOM (SPDX or CycloneDX) per deployable artifact.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Document SBOM generation in governance.RequiredControls and services[].Tags for CI/CD.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"
      ],
      "frameworkMappings": [
        {
          "framework": "SLSA / SSDF",
          "theme": "SLSA \u2014 SBOM generation"
        }
      ]
    },
    {
      "id": "supply-chain-002",
      "title": "SBOM stored with artifact in registry",
      "description": "SBOM must be retained alongside container images and packages in ACR or artifact store.",
      "severity": "High",
      "priority": "P0",
      "remediationGuidance": "Tag sbom-attached on services[].Tags; describe storage in metadata.ChangeDescription.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"
      ],
      "frameworkMappings": [
        {
          "framework": "SLSA / SSDF",
          "theme": "SLSA \u2014 SBOM provenance storage"
        }
      ]
    },
    {
      "id": "supply-chain-003",
      "title": "Dependency vulnerability scanning in CI",
      "description": "Third-party dependencies must be scanned on every build with fail thresholds for critical CVEs.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Describe scan gates in governance.RequiredControls.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"
      ],
      "frameworkMappings": [
        {
          "framework": "SLSA / SSDF",
          "theme": "NIST SSDF \u2014 PW.4 vulnerability analysis"
        }
      ]
    },
    {
      "id": "supply-chain-004",
      "title": "Signed container images",
      "description": "Production images must document cosign/Notary or ACR content trust signing.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Record image signing in governance.RequiredControls and services[].Tags.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",

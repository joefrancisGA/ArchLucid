    {
      "id": "cis-gcp-001",
      "title": "MFA enforced for privileged GCP AD roles",
      "description": "Global Administrator and other privileged Cloud IAM roles must document MFA enforcement \u2014 not password-only administrative access.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Record MFA policy in governance.RequiredControls; cite Conditional Access and privileged role assignments from gcpExtractor when present.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription",
        "gcpExtractor.manifest.manifest.RawJson",
        "datastores[].DatastoreType",
        "datastores[].RuntimePlatform",
        "datastores[].Tags",
        "relationships[].relationshipType",
        "services[].Purpose",
        "gcpExtractor.manifest.RawJson",
        "gcpExtractor.manifest.ScopeId",
        "gcpExtractor.manifest.Scope",
        "gcpExtractor.manifest.CollectionTimestamp",
        "gcpExtractor.manifest.SwitchesUsed"
      ],
      "frameworkMappings": [
        {
          "framework": "CIS GCP Foundations Benchmark",
          "theme": "CIS 1.1 \u2014 Ensure MFA enabled for privileged users"
        }
      ]
    },
    {

  "pack": {
    "name": "CIS Google Cloud Platform Foundation Benchmark",
    "description": "CIS-aligned GCP hardening themes for architecture review. Grounded in GCP inventory ZIP and Terraform google_* evidence. Not CIS benchmark pass/fail.",

  "pack": {
    "name": "AWS Resiliency & Disaster Recovery",
    "description": "Multi-AZ, Route 53, AWS Backup, and cross-region replication themes for AWS workloads.",
    "version": "1.1.0",
    "category": "Reliability",
    "isDefault": true,
    "suggestedPackType": "PlatformDefault",
    "policyPackContentDocumentPath": "docs/samples/policy-packs/aws-resiliency-dr.json"

  "rules": [
    {
      "id": "aws-dr-003",
      "title": "Multi-region deployment for critical workloads",
      "description": "Tier-1 services should document active-active or active-passive multi-region strategy with failover triggers.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Describe region pairs in metadata.ChangeDescription; align region tags on services[].Tags with awsExtractor locations.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription",
        "awsExtractor.manifest.manifest.RawJson",
        "datastores[].DatastoreType",
        "datastores[].RuntimePlatform",
        "datastores[].Tags",
        "relationships[].relationshipType",
        "services[].Purpose",
        "awsExtractor.manifest.RawJson",
        "awsExtractor.manifest.ScopeId",
        "awsExtractor.manifest.Scope",
        "awsExtractor.manifest.CollectionTimestamp",
        "awsExtractor.manifest.SwitchesUsed"
      ],
      "frameworkMappings": [
        {
          "framework": "AWS Well-Architected",
          "theme": "WAF Reliability \u2014 Multi-region architecture"
        }
      ]
    },
    {

  "rules": [
    {
      "id": "aws-dr-001",
      "title": "Availability targets documented per workload tier",
      "description": "Each service tier must state availability objective (e.g., 99.9%, 99.99%) so reliability design can be assessed against business need.",
      "severity": "High",
      "priority": "P0",
      "remediationGuidance": "Tag tier and SLA target on services[].Tags; document targets in governance.PolicyConstraints.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription",
        "awsExtractor.manifest.RawJson",
        "awsExtractor.manifest.ScopeId",
        "awsExtractor.manifest.Scope",
        "awsExtractor.manifest.CollectionTimestamp",
        "awsExtractor.manifest.SwitchesUsed"
      ],
      "frameworkMappings": [
        {
          "framework": "AWS Well-Architected",
          "theme": "WAF Reliability \u2014 Define availability targets"
        }
      ]
    },
    {
      "id": "aws-dr-002",
      "title": "RTO and RPO defined for tier-1 systems",
      "description": "Business-critical components must document recovery time and recovery point objectives \u2014 not undefined best-effort DR.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Record RTO/RPO in governance.PolicyConstraints and metadata.ChangeDescription for tier-1 services and datastores.",
      "evidenceHints": [

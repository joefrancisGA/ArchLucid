    {
      "id": "otel-005",
      "title": "Centralized log aggregation (Log Analytics/Splunk)",
      "description": "All production logs must route to centralized SIEM/log platform with retention.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Document log sink in governance.RequiredControls; align with azureExtractor diagnostics.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription",
        "azureExtractor.manifest.RawJson",
        "datastores[].DatastoreType",
        "datastores[].RuntimePlatform",
        "datastores[].Tags",
        "relationships[].relationshipType",
        "services[].Purpose"
      ],
      "frameworkMappings": [
        {
          "framework": "OpenTelemetry",
          "theme": "OpenTelemetry \u2014 Log aggregation"
        }
      ]
    },
    {

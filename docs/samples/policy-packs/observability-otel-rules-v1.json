{
  "schemaVersion": 1,
  "kind": "archlucid.policyPack.curatedRules.v1",
  "pack": {
    "name": "Observability & OpenTelemetry Baseline",
    "description": "Distributed tracing, metrics, and centralized logging themes before production approval.",
    "version": "1.1.0",
    "category": "Operations",
    "isDefault": true,
    "suggestedPackType": "PlatformDefault",
    "policyPackContentDocumentPath": "docs/samples/policy-packs/observability-otel.json"
  },
  "rules": [
    {
      "id": "otel-001",
      "title": "OpenTelemetry SDK instrumentation planned",
      "description": "Services must document OTel SDK or auto-instrumentation for traces, metrics, and logs.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Tag otel-instrumented on services[].Tags and governance.RequiredControls.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"
      ],
      "frameworkMappings": [
        {
          "framework": "OpenTelemetry",
          "theme": "OpenTelemetry \u2014 SDK instrumentation"
        }
      ]
    },
    {
      "id": "otel-002",
      "title": "Distributed tracing across service boundaries",
      "description": "Cross-service requests must propagate trace context (W3C traceparent) end-to-end.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Document trace propagation in governance.PolicyConstraints and relationships[].",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"
      ],
      "frameworkMappings": [
        {
          "framework": "OpenTelemetry",
          "theme": "OpenTelemetry \u2014 Distributed tracing"
        }
      ]
    },
    {
      "id": "otel-003",
      "title": "Metrics exported in Prometheus or OTLP format",
      "description": "Golden signals (latency, traffic, errors, saturation) must be documented per tier.",
      "severity": "High",
      "priority": "P0",
      "remediationGuidance": "List metric endpoints in governance.RequiredControls and services[].Tags.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"
      ],
      "frameworkMappings": [
        {
          "framework": "OpenTelemetry",
          "theme": "OpenTelemetry \u2014 Metrics export"
        }
      ]
    },
    {
      "id": "otel-004",
      "title": "Structured logging with correlation IDs",
      "description": "Logs must include trace_id/span_id or correlation ID linking to requests.",
      "severity": "High",
      "priority": "P0",
      "remediationGuidance": "Capture logging standard in governance.PolicyConstraints.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription"

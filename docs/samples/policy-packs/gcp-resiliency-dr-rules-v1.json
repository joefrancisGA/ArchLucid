  "rules": [
    {
      "id": "gcp-dr-003",
      "title": "Multi-region deployment for critical workloads",
      "description": "Tier-1 services should document active-active or active-passive multi-region strategy with failover triggers.",
      "severity": "Critical",
      "priority": "P0",
      "remediationGuidance": "Describe region pairs in metadata.ChangeDescription; align region tags on services[].Tags with gcpExtractor locations.",
      "evidenceHints": [
        "governance.PolicyConstraints",
        "governance.RequiredControls",
        "governance.ComplianceTags",
        "services[].Tags",
        "metadata.ChangeDescription",
        "gcpExtractor.manifest.manifest.RawJson",
        "datastores[].DatastoreType",
        "datastores[].RuntimePlatform",
        "datastores[].Tags",
        "relationships[].relationshipType",
        "services[].Purpose",
        "gcpExtractor.manifest.RawJson",
        "gcpExtractor.manifest.ScopeId",
        "gcpExtractor.manifest.Scope",
        "gcpExtractor.manifest.CollectionTimestamp",
        "gcpExtractor.manifest.SwitchesUsed"
      ],
      "frameworkMappings": [
        {
          "framework": "GCP Well-Architected",
          "theme": "WAF Reliability \u2014 Multi-region architecture"
        }
      ]
    },

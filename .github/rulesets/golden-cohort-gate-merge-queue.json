{
  "name": "Golden cohort real-LLM gate (merge queue draft)",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/master", "refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "merge_queue",
      "parameters": {
        "check_response_timeout_minutes": 60,
        "grouping_strategy": "HEADGREEN",
        "max_entries_to_build": 5,
        "max_entries_to_merge": 5,
        "merge_method": "SQUASH",
        "min_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 5
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "cohort-real-llm-gate"
          },
          {
            "context": "Security: gitleaks (secret scan)"
          },
          {
            "context": ".NET: fast core (corset)"
          },
          {
            "context": "Operator UI: typecheck (blocking)"
          },
          {
            "context": "CI: beta-readiness wiring guards"
          }
        ]
      }
    }
  ]
}

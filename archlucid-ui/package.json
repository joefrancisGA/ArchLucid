{
  "name": "archlucid-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "demo": "pwsh -File ./scripts/start-demo.ps1",
    "generate:brand-raster": "node ./scripts/generate-brand-raster.mjs",
    "generate:deferred-chunk-loaders": "node ./scripts/generate-deferred-chunk-import-loaders.mjs",
    "generate:pricing": "node ./scripts/invoke-generate-pricing.mjs",
    "prebuild": "npm run generate:brand-raster",
    "clean:next-export": "node ./scripts/clean-next-export.mjs",
    "sync:glossary": "tsx ../scripts/ui/sync-glossary.ts",
    "build": "npm run build:api-types && npm run sync:glossary && npm run generate:pricing && npm run generate:deferred-chunk-loaders && npm run build:help-index && npm run build:docs-pdf && npm run clean:next-export && next build",
    "build:analyze": "pwsh -NoProfile -Command \"$env:ANALYZE='1'; npm run build\"",
    "check:first-load-js": "node ./scripts/first-load-js-baseline.mjs check",
    "check:operator-home-proxy-trace": "node ./scripts/operator-home-startup-proxy-trace.mjs check",
    "write:operator-home-proxy-trace-baseline": "node ./scripts/operator-home-startup-proxy-trace.mjs write-baseline",
    "lighthouse:ci": "node ./scripts/run-lighthouse-ci.mjs",
    "lighthouse:acceptance": "node ./scripts/run-lighthouse-acceptance.mjs",
    "write:first-load-js-baseline": "node ./scripts/first-load-js-baseline.mjs write-baseline",
    "build:help-index": "node ./scripts/build-help-search-index.mjs",
    "build:docs-pdf": "tsx ./scripts/build-docs-pdf.ts",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "lint:terminology": "vitest run src/lib/review-terminology-guard.test.ts src/lib/review-terminology-scanner.test.ts src/lib/review-terminology-copy.test.ts",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:vitest-single-worker": "vitest run --pool=forks --maxWorkers=1",
    "test:axe-components": "vitest run src/accessibility",
    "test:e2e": "playwright test -c playwright.mock.config.ts",
    "test:e2e:mock:functional": "playwright test -c playwright.mock.config.ts --project=chromium",
    "test:e2e:mock:operator-shell": "playwright test -c playwright.operator-mock.config.ts --project=chromium-operator-shell",
    "test:e2e:mock:visual": "playwright test -c playwright.mock.config.ts --project=chromium-visual",
    "test:a11y": "playwright test -c playwright.mock.config.ts --project=chromium-accessibility",
    "test:e2e:accessibility": "playwright test -c playwright.mock.config.ts --project=chromium-accessibility",
    "test:e2e:help-redirects": "playwright test -c playwright.mock.config.ts --grep @help-redirects",
    "e2e:mock": "playwright test -c playwright.mock.config.ts",
    "screenshots": "playwright test -c playwright.mock.config.ts capture-marketing-screenshots.spec.ts",
    "screenshots:all": "playwright test -c playwright.mock.config.ts capture-all-screenshots.spec.ts --workers=50%",
    "screenshots:demo": "playwright test --project=chromium e2e/live-api-demo-screenshots.spec.ts",
    "screenshots:all:prebuilt": "node ./scripts/run-screenshots-all-prebuilt.mjs",
    "ux-audit:screenshots:buyer": "playwright test -c playwright.mock.config.ts --project=chromium-ux-audit-buyer",
    "ux-audit:screenshots:operator": "playwright test -c playwright.operator-mock.config.ts --project=chromium-ux-audit-operator",
    "ux-audit:screenshots:marketing": "playwright test -c playwright.mock.config.ts --project=chromium-ux-audit-marketing",
    "ux-audit": "pwsh -NoProfile -File ./scripts/run-ux-audit.ps1",
    "test:e2e:live": "playwright test",
    "test:e2e:founder": "playwright test -c playwright.founder.config.ts --grep @founder",
    "test:e2e:founder:headed": "playwright test -c playwright.founder.config.ts --grep @founder --headed",
    "test:e2e:founder:ui": "playwright test -c playwright.founder.config.ts --grep @founder --ui",
    "test:e2e:founder:critical": "playwright test -c playwright.founder.config.ts --grep @critical",
    "test:e2e:founder:release-smoke": "playwright test -c playwright.founder.config.ts --grep @release-smoke",
    "test:e2e:founder:a11y": "playwright test -c playwright.founder.config.ts e2e/founder-a11y.spec.ts",
    "test:e2e:founder:console-network": "playwright test -c playwright.founder.config.ts e2e/founder-console-network.spec.ts",
    "typecheck": "npm run build:api-types && tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "generate:api-types": "node scripts/generate-api-types-split.mjs",
    "build:api-types": "npm run build -w @archlucid/api-types",
    "rebrand-check": "python3 ../scripts/ci/assert_brand_category_seam.py",
    "demo:preflight": "node ./scripts/demo-preflight.mjs",
    "run:architecture-lifecycle-batch": "tsx e2e/run-architecture-lifecycle-batch.ts",
    "security:coordinated-disclosure-pgp": "node ./scripts/security/generate-coordinated-disclosure-pgp.mjs",
    "capture:why-hero-operator-home": "playwright test -c playwright.mock.config.ts --project=chromium-capture-why-hero"
  },
  "dependencies": {
    "@archlucid/api-types": "workspace:*",
    "@azure/communication-email": "^1.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/query-sync-storage-persister": "5.101.4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "5.101.4",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.3",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.16.1",
    "next": "16.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.9.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "toml": "^3.0.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.2.0",
    "@lhci/cli": "^0.14.0",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "openpgp": "^6.3.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "eslint": "10.8.1",
    "vite": "^8.0.16",
    "lodash-es": "^4.18.0",
    "dompurify": "^3.4.13",
    "uuid": "^11.1.1",
    "postcss": "^8.5.18",
    "undici": "^7.29.0",
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.5.0",
    "nanoid": "^3.3.18",
    "esbuild": "^0.28.1",
    "tmp": "^0.2.6",
    "cookie": "^0.7.0",
    "sharp": "0.35.0"
  }
}

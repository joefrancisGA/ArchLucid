# Backend API (used by Next.js server: RSC + /api/proxy)
ARCHLUCID_API_BASE_URL=http://localhost:5128

# Windows-only workaround: standalone output (`output: standalone`) tracing can ENOENT-copy
# page_client-reference-manifest.js during local `npm run build`. Docker/Linux CI is unaffected.
# Set to 1 to produce a normal .next bundle (fine for next start smoke tests locally).
# ARCHLUCID_SKIP_STANDALONE_OUTPUT=1

# Optional: explicit API origin for the public marketing `/demo/preview` page (server-side fetch, no `/api/proxy`).
# When unset, the page falls back to ARCHLUCID_API_BASE_URL then NEXT_PUBLIC_ARCHLUCID_API_BASE_URL.
# NEXT_PUBLIC_DEMO_PREVIEW_API_BASE=http://localhost:5128

# Optional: when API has ApiKey auth
ARCHLUCID_API_KEY=

# Public base URL (optional; defaults below). Browser calls go through /api/proxy instead.
NEXT_PUBLIC_ARCHLUCID_API_BASE_URL=http://localhost:5128

# Canonical public (marketing / apex) site URL for Open Graph / metadata (no trailing slash).
# Production split (TB-2016): https://archlucid.net — operator app uses ARCHLUCID_APP_SITE_URL.
# NEXT_PUBLIC_ARCHLUCID_SITE_URL=http://localhost:3000
#
# Dual Container App hosts (same image; set on each CA at runtime — preferred over NEXT_PUBLIC bake):
# ARCHLUCID_PUBLIC_SITE_URL=https://archlucid.net
# ARCHLUCID_APP_SITE_URL=https://app.archlucid.net
# NEXT_PUBLIC_ARCHLUCID_APP_SITE_URL=https://app.archlucid.net

# Optional: Microsoft Clarity project id (public marketing only). Loads after explicit Accept on the consent banner; see docs/go-to-market/PRIVACY_POLICY.md §2.4.
# NEXT_PUBLIC_ARCHLUCID_CLARITY_PROJECT_ID=
# Operator kill-switch — set to true to disable all marketing analytics (Clarity never loads regardless of consent):
# NEXT_PUBLIC_ARCHLUCID_MARKETING_ANALYTICS_DISABLED=true

# Marketing /welcome hero — "Request walkthrough" opens this URL with UTM (and gclid/fbclid) from the current page appended. When unset, the CTA uses mailto with a fixed subject line.
# NEXT_PUBLIC_WALKTHROUGH_BOOKING_URL=https://cal.com/your-org/archlucid-walkthrough
# Optional mailto address when no booking URL is set (omit for client default mail with subject only).
# NEXT_PUBLIC_WALKTHROUGH_MAILTO_FALLBACK=hello@yourdomain.com
# Marketing /welcome hero — "Try the self-demo" deep-link (default: seeded Workspace A run). Override when staging uses a different path. UTM + click ids from the current page are appended.
# NEXT_PUBLIC_SELF_DEMO_URL=/runs/b6ab57c8-84b1-8ac6-28d8-d790efcd1dbf
#
# Clarity custom events + staging verification: docs/go-to-market/DEMO_WORKSPACES.md#welcome-hero--ctas-analytics-and-compliance

# Prefix for in-app Help panel and glossary "Learn more" doc links (see src/lib/help-topics.ts getDocHref).
# Default matches the public ArchLucid repo on GitHub `main` (same as src/lib/docs-public-base.ts when unset).
# Override for a private docs site or a fork, e.g. https://github.com/your-org/your-fork/blob/master
NEXT_PUBLIC_DOCS_BASE_URL=https://github.com/joefrancisGA/ArchLucid/blob/master

# Optional: override "Learn more" blob base in ContextualHelp only (see contextual-help-content.ts toDocsBlobUrl).
# When unset, same base as NEXT_PUBLIC_DOCS_BASE_URL / HelpPanel default.
# NEXT_PUBLIC_ARCHLUCID_DOCS_BLOB_BASE=https://github.com/your-org/your-fork/blob/master

# Optional: trace viewer deep link on run detail / provenance (placeholder {traceId} — from API X-Trace-Id header)
# NEXT_PUBLIC_TRACE_VIEWER_URL_TEMPLATE=https://jaeger.example.com/trace/{traceId}

# UI auth seam: development-bypass | jwt | jwt-bearer (must align with API auth mode in appsettings)
NEXT_PUBLIC_ARCHLUCID_AUTH_MODE=development-bypass

# Passwordless email one-time-code sign-in (mirrors API Auth:EmailOtp:Enabled). Requires jwt or jwt-bearer API auth.
# NEXT_PUBLIC_ARCHLUCID_EMAIL_OTP_ENABLED=true

# Optional supplemental sign-in buttons on /auth/signin (comma-separated: microsoft, google).
# Microsoft appears only when NEXT_PUBLIC_OIDC_AUTHORITY is a Microsoft login host.
# Google requires NEXT_PUBLIC_GOOGLE_OIDC_AUTHORITY + NEXT_PUBLIC_GOOGLE_OIDC_CLIENT_ID below.
# NEXT_PUBLIC_ARCHLUCID_SUPPLEMENTAL_SIGN_IN_PROVIDERS=microsoft,google
# NEXT_PUBLIC_GOOGLE_OIDC_AUTHORITY=https://accounts.google.com
# NEXT_PUBLIC_GOOGLE_OIDC_CLIENT_ID=<google-oauth-client-id>
# NEXT_PUBLIC_GOOGLE_OIDC_SCOPES=openid profile email

# OIDC (authorization code + PKCE) when NEXT_PUBLIC_ARCHLUCID_AUTH_MODE=jwt — register SPA redirect URI in Entra / IdP
# NEXT_PUBLIC_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
# NEXT_PUBLIC_OIDC_CLIENT_ID=<spa-app-client-id>
# Include API scope so access token audience matches the API registration audience, e.g. api://<api-app-id>/access_as_user
# NEXT_PUBLIC_OIDC_SCOPES=openid profile offline_access api://<api-app-id>/access_as_user
# Optional fixed redirect (default: {origin}/auth/callback)
# NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional after logout (default: {origin}/)
# NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Optional: /api/proxy rate limit (in-process, per server instance). First X-Forwarded-For hop or X-Real-Ip.
# ARCHLUCID_PROXY_RATE_LIMIT_PER_MINUTE=120
# ARCHLUCID_PROXY_RATE_LIMIT_WINDOW_MS=60000
# ARCHLUCID_PROXY_RATE_LIMIT_DISABLED=true

# Production-like proxy scope (TB-075): when client scope forwarding is disabled, set trusted server scope
# from environment (Container Apps / hosted UI). Bearer JWT scope claims take precedence when present.
# ARCHLUCID_PROXY_TENANT_ID=
# ARCHLUCID_PROXY_WORKSPACE_ID=
# ARCHLUCID_PROXY_PROJECT_ID=
# ARCHLUCID_PROXY_TRUST_SERVER_SCOPE_ONLY=true
# ARCHLUCID_PROXY_ALLOW_CLIENT_SCOPE_HEADERS=false

# Buyer-polished operator shell + curated static payloads (USE BOTH for public demos / screenshots)
# NEXT_PUBLIC_DEMO_STATIC_OPERATOR=true
# NEXT_PUBLIC_DEMO_MODE=true
#
# CTO demo presenter pack (#8): expand Graph / Governance / Audit in primary nav (demo builds + E2E only).
# NEXT_PUBLIC_CTO_DEMO_NAV_EXPANDED=true
#
# Preflight (strict — fails if STATIC_OPERATOR unset):  npm run demo:preflight
# Local dev without demo flags:                       DEMO_PREFLIGHT_RELAXED=1 npm run demo:preflight

# Operator shell: hidden by default (`/recommendation-learning`, `/product-learning`) until demos are wired.
# `next dev` sets this automatically via `.env.development`; set explicitly for screenshot builds or CI that need full nav.
# NEXT_PUBLIC_OPERATOR_NAV_SHOW_PRE_RELEASE_ROUTES=1

# Optional: show the marketing header link to `/live-demo` (requires a reachable demo API base). Default: hidden — `/see-it` stays the primary proof path.
# NEXT_PUBLIC_MARKETING_LIVE_DEMO=true

# Operator shell experience: omit for buyer-default UI (simpler labels, fewer shortcut chips) — the default for new tenants.
# Set to `operator` for the full operator nav density (internal ops, power users). See docs/library/OPERATOR_UI_EXPERIENCE_MODES.md.
# NEXT_PUBLIC_OPERATOR_EXPERIENCE=operator
#
# System Administration sidebar section (internal diagnostics, sales-ops, employee tools).
# Default: enabled in `next dev` (NODE_ENV=development); disabled in production unless set.
# Legacy alias: NEXT_PUBLIC_ARCHLUCID_INTERNAL_OPERATOR=true
# NEXT_PUBLIC_FEATURES_SHOW_SYSTEM_ADMINISTRATION_NAV=true
#
# A/B evaluation — charcoal authority theme vs default teal accent (does not remove the default theme).
# Build-time default when localStorage has no override: `default` (teal) or `charcoal`.
# NEXT_PUBLIC_UI_AUTHORITY_THEME=charcoal
# Show the shell theme toggle for side-by-side evaluation:
# NEXT_PUBLIC_UI_AUTHORITY_THEME_EVAL=true

# Application Insights (browser) — field Web Vitals + route telemetry (TB-692 / TB-2031)
# NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# Sample rate 0–1 (default 0.25 when unset). Use 1 for a dense triage window.
# NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.25

# BFF proxy slow-log threshold in ms (Server-Timing always set; JSON log when slow or status>=400)
# ARCHLUCID_UI_PROXY_SLOW_MS=1000
# Optional boot log from src/instrumentation.ts register():
# ARCHLUCID_UI_SERVER_TIMING_BOOT_LOG=1

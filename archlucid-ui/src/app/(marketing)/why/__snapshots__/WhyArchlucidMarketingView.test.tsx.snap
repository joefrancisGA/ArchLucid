      </table>
    </div>
  </section>
  <section
    class="mt-10 border-t border-neutral-200 pt-8 dark:border-neutral-800"
  >
    <p
      class="text-sm text-neutral-600 dark:text-neutral-400"
    >
      For sponsor-ready language and procurement context, see the
       
      <a
        class="text-sky-700 underline underline-offset-2 dark:text-sky-400"
        href="/get-started"
      >
        getting started guide
      </a>
       
      or ask your account team for the executive overview pack.
    </p>
  </section>
</main>
`;

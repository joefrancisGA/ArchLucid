{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "jsx": "preserve",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../tests/accessibility.spec.ts",
    "../tests/compare.spec.ts",
    "../tests/onboarding.spec.ts",
    "../tests/e2e/**/*.ts",
    "../tests/quick-scan.spec.ts"
  ],
  "exclude": ["node_modules"]
}

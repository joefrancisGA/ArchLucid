# Pilot / staging tenant UI — buyer-default operator shell (do NOT set NEXT_PUBLIC_OPERATOR_EXPERIENCE=operator).
# See docs/library/OPERATOR_UI_EXPERIENCE_MODES.md and docs/runbooks/FIRST_PILOT_OPERATOR_PATH.md § Pilot UI deployment.

ARCHLUCID_API_BASE_URL=https://staging.example/archlucid-api
NEXT_PUBLIC_ARCHLUCID_API_BASE_URL=https://staging.example/archlucid-api
NEXT_PUBLIC_ARCHLUCID_AUTH_MODE=jwt-bearer

# Omit NEXT_PUBLIC_OPERATOR_EXPERIENCE — buyer-polished labels, no AI budget pill in header.
# Engineers use archlucid-ui/.env.development with NEXT_PUBLIC_OPERATOR_EXPERIENCE=operator locally only.

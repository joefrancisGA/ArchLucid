# Loaded automatically in `next dev` (see https://nextjs.org/docs/app/building-your-application/configuring/environment-variables).
# Ensures Help panel and contextual "Open documentation" links resolve without copying `.env.local`.
NEXT_PUBLIC_DOCS_BASE_URL=https://github.com/joefrancisGA/ArchLucid/blob/master
# When ArchLucid.Api is not running locally, sandbox GET fixtures + static demo fallbacks keep RSC
# navigations from failing on proxy 502s (remove or override in `.env.local` when using a live API).
VITE_USE_SANDBOX_MOCKS=true
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_DEMO_STATIC_OPERATOR=1
# Full sidebar links including tenant cost and learning routes (omit in screenshot-only/demo prod if those pages are not ready).
NEXT_PUBLIC_OPERATOR_NAV_SHOW_PRE_RELEASE_ROUTES=1
# Local engineers: full operator shell density (omit in buyer-only pilot deploys; unset NEXT_PUBLIC_OPERATOR_EXPERIENCE there).
NEXT_PUBLIC_OPERATOR_EXPERIENCE=operator
# Show System Administration nav section in local dev (also defaults on when NODE_ENV=development).
NEXT_PUBLIC_FEATURES_SHOW_SYSTEM_ADMINISTRATION_NAV=true

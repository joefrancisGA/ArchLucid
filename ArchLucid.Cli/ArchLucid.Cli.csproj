<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>archlucid</ToolCommandName>
    <PackageId>ArchLucid.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>ArchLucid</Authors>
    <Description>CLI for ArchLucid: create projects, run architecture requests, and inspect results.</Description>
    <PackageTags>architecture;cli;archlucid</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Json.More.Net" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArchLucid.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\schemas\*.schema.json" Link="schemas\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\proof_packet_claim_lint_rules.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\citation_integrity_rules.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\first_review_ui_route_smoke_contract.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\ship_gate_export_matrix_contract.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\first_review_completion_contract.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\principal_architect_return_trigger_rules.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\buyer_proof_evidence_ledger_rules.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Data\decision_owner_scoreboard_rules.v1.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\deploy\archlucid.stack.schema.json" Link="deploy\archlucid.stack.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArchLucid.Api.Client\ArchLucid.Api.Client.csproj" />
    <ProjectReference Include="..\ArchLucid.Application\ArchLucid.Application.csproj" />
    <ProjectReference Include="..\ArchLucid.Core\ArchLucid.Core.csproj" />
    <ProjectReference Include="..\ArchLucid.Contracts\ArchLucid.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ArchLucid.Core" />
    <Using Include="ArchLucid.Core.Manifest" />
  </ItemGroup>

</Project>

location = "eastus2"
resource_group_name = "rg-archlucid-prod"
sql_server_name = "sql-archlucid-prod"
sql_database_name = "ArchLucid"
sql_admin_login = "sqlbreakglass"
sql_admin_password = "CHANGE_ME"
entra_admin_login = "ArchLucid SQL Admins"
entra_admin_object_id = "00000000-0000-0000-0000-000000000000"
sql_sku = "GP_S_Gen5_2"
private_endpoint_subnet_id = "/subscriptions/.../resourceGroups/rg-archlucid-prod/providers/Microsoft.Network/virtualNetworks/vnet-app/subnets/snet-data"

# Backup / DR (Improvement #43)
backup_storage_redundancy = "Geo"
sql_pitr_retention_days   = 35
sql_ltr_weekly_retention  = "P1M"
sql_ltr_monthly_retention = "P12M"
sql_ltr_yearly_retention  = "P7Y"
sql_ltr_week_of_year      = 1

# Security / Defender (Improvement #47)
# log_analytics_workspace_id = "/subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/..."
# enable_sql_monitoring      = true
# enable_sql_defender        = true
# alert_email_address        = "ops@example.com"
# sql_audit_retention_days   = 90

# TDE CMK (Improvement #49) — requires terraform-keyvault + SQL server system-assigned identity
# enable_sql_tde_cmk            = true
# key_vault_name                = "kv-archlucid-prod"
# key_vault_resource_group_name = "rg-archlucid-prod"

# Production monitoring: two-tier alert routing (Improvement #46).
# Copy to terraform.tfvars (gitignored). Store phone numbers and PagerDuty webhook in Key Vault — not here.

posture_tier                    = "production"
enable_monitoring_stack         = true
enable_critical_action_group    = true
read_alert_secrets_from_key_vault = true

# resource_group_name = "rg-archlucid-prod"
# name_prefix         = "archlucid"
# alert_email_address = "ops@example.com"

# Country codes are not highly sensitive; phone numbers and PagerDuty URL come from Key Vault.
# alert_sms_country_code   = "1"
# alert_voice_country_code = "1"

# alert_secrets_key_vault_name                = "kv-archlucid-prod"
# alert_secrets_key_vault_resource_group_name = "rg-archlucid-prod"

# Optional: override default secret names (alert-sms-phone-number, alert-voice-phone-number, alert-pagerduty-webhook-uri)
# alert_sms_phone_number_secret_name        = "alert-sms-phone-number"
# alert_voice_phone_number_secret_name      = "alert-voice-phone-number"
# alert_pagerduty_webhook_uri_secret_name   = "alert-pagerduty-webhook-uri"

# Container App resource IDs + CPU threshold (see terraform.tfvars.example).
# enable_prometheus_slo_rule_group = true
# azure_monitor_workspace_id       = "/subscriptions/.../providers/Microsoft.Monitor/accounts/..."

# TB-909 — subscription cost anomaly alert + rollup budget (not gated by TB-903 posture tier).
# enable_subscription_cost_management = true  # default; set false to opt out
# subscription_cost_rollup_budget_components mirrors per-root production.tfvars.example amounts:
#   container_apps = 3500, sql = 2500, openai = 5000 → rollup = 11000 × 1.2 = 13200
subscription_cost_rollup_budget_time_period_start = "2026-04-01T00:00:00Z"
subscription_cost_rollup_budget_contact_emails    = ["finops@example.com"]

tags = {
  workload = "archlucid"
  tier     = "monitoring"
}

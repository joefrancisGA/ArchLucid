# Copy to terraform.tfvars (gitignored) and fill deployer_object_id before apply.
#
#   cp terraform.tfvars.example terraform.tfvars
#   az login
#   az account set --subscription "<your-analysis-subscription-id>"

location             = "centralus"
name_prefix          = "alsandbox"
deployer_object_id   = "00000000-0000-0000-0000-000000000000" # replace — az ad signed-in-user show --query id -o tsv
budget_contact_email = "you@example.com"
monthly_budget_usd   = 150

# Diagram-rich defaults (ADF on; Service Bus adds ~$10/mo — enable when you need messaging edges).
enable_data_factory = true
enable_service_bus  = false
enable_event_grid   = false

# Cost guardrails
sql_sku_name                      = "GP_S_Gen5_1"
sql_auto_pause_delay_in_minutes   = 60
log_analytics_daily_quota_gb      = 1

tags = {
  workload = "archlucid-analysis-sandbox"
  purpose  = "securenow-diagram-analysis"
  teardown = "true"
  owner    = "your-alias"
}

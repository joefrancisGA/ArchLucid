# Staging-oriented example: merge into terraform.tfvars or pass explicitly, e.g.:
#   terraform apply -var-file=staging.tfvars.example

posture_tier                  = "staging"
enable_storage_account        = true
create_resource_group         = false
resource_group_name           = "rg-archlucid-staging"
location                      = "eastus2"
storage_account_name          = "starchlucidstagingarts"
account_replication_type      = "LRS"
# Staging may temporarily allow public access during PE cutover; production forbids it via posture_checks.
public_network_access_enabled = true

tags = {
  workload    = "archlucid"
  tier        = "staging"
  environment = "staging"
}

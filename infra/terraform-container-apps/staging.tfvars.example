# Staging-oriented example: merge into staging.tfvars (gitignored) or use:
#   terraform apply -var-file=staging.tfvars.example
# See production.tfvars.example for production replica/budget knobs. TB-905 drill: secondary region always on; SQL failover enabled for drill window only.

posture_tier          = "staging"
enable_container_apps = true
create_resource_group   = true
resource_group_name     = "rg-archlucid-ca-staging"
location                = "eastus2"

api_container_image = "<your-acr>.azurecr.io/archlucid:<staging-tag>"
ui_container_image  = "<your-acr>.azurecr.io/archlucid-ui:<staging-tag>"

# TB-755: required before CD canary traffic split (cd.yml CD_CANARY_ENABLED).
api_revision_mode = "Multiple"

api_min_replicas = 2
# TB-947: size api_max_replicas with README § "API max-replicas sizing" — bulkhead (default MaxConcurrentHandlers=8) × replicas must fit AOAI TPM.
# Example: 240K TPM × 0.7 headroom ÷ 8K TPM/handler ≈ 21 parallel handlers → ceil(21/8)=3 replica cap for Real-heavy load (HTTP-only bursts may justify higher).
api_max_replicas = 6
ui_min_replicas  = 1
ui_max_replicas  = 6

worker_min_replicas = 1
worker_max_replicas = 10

api_scale_concurrent_requests = 15
ui_scale_concurrent_requests  = 10

# TB-915: API HTTP + CPU scale rules on by default (see README § Scale-rule mix).
# api_cpu_scale_utilization_percent = 70

artifact_blob_service_uri   = "https://<storage-account>.blob.core.windows.net/"
artifact_storage_account_id = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<name>"

tags = {
  workload    = "archlucid"
  tier        = "staging"
  environment = "staging"
}

finops_environment = "staging"

# TB-903 / TB-905: secondary region always on in staging; geo-failover drill exercises Front Door secondary origin + paired compute.
secondary_region_stack_enabled   = true
secondary_resource_group_name    = "rg-archlucid-ca-staging-secondary"
secondary_location               = "centralus"
# secondary_container_apps_subnet_id = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>/subnets/<subnet>"

resource_group_name = "rg-archlucid-prod-example"
location            = "eastus2"

openai_compose_mode          = "create"
openai_account_name          = "aoai-archlucid-prod-example"
openai_custom_subdomain_name = "aoai-archlucid-prod-example"
openai_enable_chat_deployment      = true
openai_chat_deployment_name        = "gpt-4o"
openai_enable_embedding_deployment = true
openai_embedding_deployment_name   = "text-embedding-3-small"

# Optional — enable when alerting on Cognitive/OpenAI spend (TB-093).
# enable_openai_consumption_budget         = true
# openai_consumption_budget_contact_emails = ["platform-ops@example.com"]

search_compose_mode = "create"
search_service_name = "srch-archlucid-prod-example"

# Optional — wire Log Analytics + composed resource ids for platform diagnostics (TB-099).
# log_analytics_workspace_id     = "/subscriptions/.../resourceGroups/.../providers/Microsoft.OperationalInsights/workspaces/..."
# container_app_resource_ids     = ["/subscriptions/.../providers/Microsoft.App/containerApps/archlucid-api"]
# service_bus_namespace_id       = "/subscriptions/.../providers/Microsoft.ServiceBus/namespaces/..."
# artifact_storage_account_id    = "/subscriptions/.../providers/Microsoft.Storage/storageAccounts/..."

tags = {
  environment = "production"
  product     = "archlucid"
}

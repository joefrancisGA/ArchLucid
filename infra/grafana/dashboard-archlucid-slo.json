        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "archlucid_run_export_blob_push_outbox_dead_letter",
          "legendFormat": "dead-letter rows",
          "refId": "A"
        }
      ],

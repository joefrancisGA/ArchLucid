<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ArchLucid.Api.Client</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ArchLucid.Api.Client</PackageId>
    <Version>$(ArchLucidApiClientPackageVersion)</Version>
    <AssemblyVersion>$(ArchLucidApiClientPackageVersion)</AssemblyVersion>
    <FileVersion>$(ArchLucidApiClientPackageVersion)</FileVersion>
    <Title>ArchLucid API HTTP client (OpenAPI v1)</Title>
    <Description>NSwag-generated HTTP client for ArchLucid API v1. Built from the same OpenAPI document as contract tests (ArchLucid.Api.Tests Contracts/openapi-v1.contract.snapshot.json). Set BaseUrl on the client to your API host.</Description>
    <PackageTags>ArchLucid;OpenAPI;NSwag;HttpClient</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: missing XML on NSwag-generated members. TreatWarningsAsErrors is set repo-wide; add analyzer/compiler codes here only for Generated/*.g.cs output—never broaden NoWarn to hide issues in hand-written code. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.MSBuild">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="nswag.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Generated\README.md" />
    <Compile Include="ArchLucidApiClientPackage.cs" />
    <Compile Include="ArchLucidApiClientSerializerSettings.cs" />
    <Compile Include="ProblemDetails.cs" />
    <!-- Path is fixed; GenerateArchLucidOpenApiClient runs BeforeCompile so the file exists for CoreCompile. Do not gate this Include on Exists() — that is evaluation-time and would skip a fresh-clone generate. -->
    <Compile Include="Generated\ArchLucidApiClient.g.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Emergency offline skip only when a previously generated file is already on disk. -->
    <SkipGenerateArchLucidOpenApiClient Condition="('$(ARCHLUCID_SKIP_OPENAPI_CLIENT_REGEN)' == '1' Or '$(ArchLucidSkipNSwag)' == 'true') And Exists('$(MSBuildProjectDirectory)/Generated/ArchLucidApiClient.g.cs')">true</SkipGenerateArchLucidOpenApiClient>
  </PropertyGroup>

  <Target Name="GenerateArchLucidOpenApiClient" BeforeTargets="BeforeCompile" DependsOnTargets="PrepareForBuild" Condition="'$(SkipGenerateArchLucidOpenApiClient)' != 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Generated" />
    <Exec Command="$(NSwagExe_Net100) run &quot;$(MSBuildProjectDirectory)/nswag.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="EnsureArchLucidOpenApiClientGenerated" AfterTargets="GenerateArchLucidOpenApiClient" BeforeTargets="BeforeCompile">
    <Error Text="NSwag did not produce Generated/ArchLucidApiClient.g.cs. Build ArchLucid.Api.Client without ARCHLUCID_SKIP_OPENAPI_CLIENT_REGEN / ArchLucidSkipNSwag, or restore the NSwag.MSBuild package."
           Condition="!Exists('$(MSBuildProjectDirectory)/Generated/ArchLucidApiClient.g.cs')" />
  </Target>

</Project>

{
  "ArtifactLargePayload": {
    "Enabled": true,
    "MinimumUtf16LengthToOffload": 65536,
    "MinimumArtifactContentUtf16LengthToOffload": 65536,
    "BlobProvider": "AzureBlob",
    "LocalRootPath": "",
    "AzureBlobServiceUri": ""
  },
  "HotPathCache": {
    "Enabled": true,
    "Provider": "Auto",
    "ExpectedApiReplicaCount": 1,
    "AbsoluteExpirationSeconds": 60,
    "RedisConnectionString": ""
  },
  "ArchLucidAuth": {
    "Mode": "JwtBearer",
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "MultiTenantEntra": false,
    "AllowedEntraTenantIds": "",
    "Audience": "api://archlucid-api",
    "DevUserId": "dev-user",
    "DevUserName": "Developer",
    "DevRole": "Admin"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-ui-hostname"
    ]
  },
  "LlmTokenQuota": {
    "Enabled": true,
    "WindowMinutes": 60,
    "MaxPromptTokensPerTenantPerWindow": 2000000,
    "MaxCompletionTokensPerTenantPerWindow": 500000,
    "AssumedMaxPromptTokensPerRequest": 32768,
    "AssumedMaxCompletionTokensPerRequest": 8192
  },
  "LlmDailyTenantBudget": {
    "Enabled": true,
    "HardCutoffTokensPerUtcDay": 2000000,
    "WarnFraction": 0.8,
    "AssumedMaxTotalTokensPerRequest": 65536
  },
  "LlmPromptRedaction": {
    "Enabled": true,
    "ReplacementToken": "[REDACTED]"
  },
  "WebhookDelivery": {
    "UseCloudEventsEnvelope": true
  },
  "Billing": {
    "Provider": "Stripe",
    "AzureMarketplace": {
      "LandingPageUrl": "https://your-ui-hostname/marketplace/landing",
      "MarketplaceOfferId": "",
      "OpenIdMetadataAddress": "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration",
      "ValidAudiences": [ "https://marketplaceapi.microsoft.com" ],
      "FulfillmentApiEnabled": true,
      "GaEnabled": true
    }
  },
  "Observability": {
    "Tracing": {
      "SamplingRatio": 1.0
    },
    "Prometheus": {
      "Enabled": true,
      "ScrapePath": "/metrics",
      "RequireScrapeAuthentication": true,
      "ScrapeUsername": "",
      "ScrapePassword": ""
    },
    "Otlp": {
      "Enabled": true,
      "Endpoint": "",
      "Protocol": "HttpProtobuf",
      "Headers": ""
    },
    "AzureMonitor": {
      "ApplicationInsightsConnectionString": ""
    }
  },
  "Email": {
    "Provider": "Noop",
    "PricingQuoteSalesInbox": "sales@archlucid.net"
  },
  "ArchLucid": {
    "Agents": {
      "Faithfulness": {
        "EmbeddingEnabled": false
      },
      "LlmJudge": {
        "Enabled": false,
        "DeploymentName": "",
        "MaxInputCharacters": 56000,
        "MaxCompletionTokens": 400,
        "TimeoutSeconds": 25,
        "SkipWhenSimulator": true
      }
    },
    "Llm": {
      "RedactReasoningTrace": true
    },
    "ContentSafety": {
      "FailClosedOnSdkError": true,
      "BlockSeverityThreshold": 4,
      "EvaluateCompletionPromptAndResponse": true
    },
    "AgentOutput": {
      "QualityGate": {
        "Enabled": true,
        "Mode": "PilotStrict",
        "StructuralWarnBelow": 0.85,
        "SemanticWarnBelow": 0.65,
        "StructuralRejectBelow": 0.7,
        "SemanticRejectBelow": 0.5,
        "PilotStrictMinStructuralCompleteness": 0.9,
        "PilotStrictMinSemanticScore": 0.5,
        "PilotStrictMinEvidenceRefCount": 2,
        "PilotStrictMinFaithfulnessSupportRatio": 0.6,
        "PilotStrictMinAgentResultFaithfulnessSupportRatio": 0.7,
        "HeuristicEvaluatorTightenedThresholds": true,
        "PerAgentTypeFloors": {
          "Topology": {
            "StructuralRejectBelow": 0.85,
            "SemanticRejectBelow": 0.65
          },
          "Compliance": {
            "StructuralRejectBelow": 0.8,
            "SemanticRejectBelow": 0.6
          },
          "Cost": {
            "StructuralRejectBelow": 0.75,
            "SemanticRejectBelow": 0.55
          },
          "Critic": {
            "StructuralRejectBelow": 0.65,
            "SemanticRejectBelow": 0.5
          }
        },
        "EnforceOnReject": true,
        "BlockRunOnReject": true,
        "PersistPartialOutputsOnBudgetExceeded": true
      }
    }
  },
  "AgentExecution": {
    "SchemaValidation": {
      "EnforceOnParse": true
    }
  }
}

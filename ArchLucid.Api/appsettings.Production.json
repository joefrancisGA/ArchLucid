{
  "ArtifactLargePayload": {
    "Enabled": true,
    "MinimumUtf16LengthToOffload": 65536,
    "MinimumArtifactContentUtf16LengthToOffload": 65536,
    "BlobProvider": "AzureBlob",
    "LocalRootPath": "",
    "AzureBlobServiceUri": ""
  },
  "HotPathCache": {
    "Enabled": true,
    "Provider": "Auto",
    "ExpectedApiReplicaCount": 1,
    "AbsoluteExpirationSeconds": 60,
    "RedisConnectionString": ""
  },
  "ArchLucidAuth": {
    "Mode": "JwtBearer",
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "MultiTenantEntra": false,
    "AllowedEntraTenantIds": "",
    "Audience": "api://archlucid-api",
    "FailClosedOnOidcDiscoveryError": true,
    "DevUserId": "dev-user",
    "DevUserName": "Developer",
    "DevRole": "Admin"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-ui-hostname"
    ]
  },
  "LlmTokenQuota": {
    "Enabled": true,
    "WindowMinutes": 60,
    "MaxPromptTokensPerTenantPerWindow": 2000000,
    "MaxCompletionTokensPerTenantPerWindow": 500000,
    "AssumedMaxPromptTokensPerRequest": 32768,
    "AssumedMaxCompletionTokensPerRequest": 8192
  },
  "LlmDailyTenantBudget": {
    "Enabled": true,
    "HardCutoffTokensPerUtcDay": 2000000,
    "WarnFraction": 0.8,
    "AssumedMaxTotalTokensPerRequest": 65536
  },
  "LlmPromptRedaction": {
    "Enabled": true,
    "ReplacementToken": "[REDACTED]"
  },
  "WebhookDelivery": {
    "UseCloudEventsEnvelope": true
  },
  "Billing": {
    "Provider": "Stripe",
    "AzureMarketplace": {
      "LandingPageUrl": "https://your-ui-hostname/marketplace/landing",
      "MarketplaceOfferId": "",
      "OpenIdMetadataAddress": "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration",
      "ValidAudiences": [ "https://marketplaceapi.microsoft.com" ],
      "FulfillmentApiEnabled": true,
      "GaEnabled": true
    }
  },
  "Observability": {
    "Tracing": {
      "SamplingRatio": 1.0
    },
    "Prometheus": {
      "Enabled": true,
      "ScrapePath": "/metrics",
      "RequireScrapeAuthentication": true,
      "ScrapeUsername": "",
      "ScrapePassword": ""
    },
    "Otlp": {
      "Enabled": true,
      "Endpoint": "",
      "Protocol": "HttpProtobuf",
      "Headers": ""
    },
    "AzureMonitor": {
      "ApplicationInsightsConnectionString": ""
    }
  },
  "Email": {
    "Provider": "Noop",
    "PricingQuoteSalesInbox": "sales@archlucid.net",
    "SupportInbox": "support@archlucid.net"
  },
  "ArchLucid": {
    "FallbackLlm": {
      "Enabled": false,
      "Endpoints": []
    },
    "Agents": {
      "Faithfulness": {
        "EmbeddingEnabled": false
      },
      "LlmFaithfulness": {
        "Enabled": true,
        "SkipWhenSimulator": true,
        "EnforcePhaseB": true,
        "MinScoreRejectBelow": 0.65,
        "MinScoreWarnBelow": 0.70
      },
      "LlmJudge": {
        "Enabled": true,
        "DeploymentName": "",
        "MaxInputCharacters": 56000,
        "MaxCompletionTokens": 400,
        "TimeoutSeconds": 25,
        "SkipWhenSimulator": true
      }
    },
    "Llm": {
      "RedactReasoningTrace": true
    },
    "AuthorityCommit": {
      "ValidateGoldenManifestSchema": true
    },
    "Governance": {
      "PreCommitGateEnabled": true
    },
    "SqlConnectionPool": {
      "MaxPoolSize": 200,
      "MultipleActiveResultSets": false
    },
    "SqlConnectionPoolWarmup": {
      "Enabled": true,
      "ConnectionCount": 4
    },
    "WarmTenantCatalog": {
      "Enabled": true,
      "TargetDepth": 3,
      "ReplenishIntervalMinutes": 30,
      "LowDepthWarningThreshold": 1
    },
    "ContentSafety": {
      "FailClosedOnSdkError": true,
      "BlockSeverityThreshold": 4,
      "EvaluateCompletionPromptAndResponse": true
    },
    "AgentOutput": {
      "QualityGate": {
        "Enabled": true,
        "Mode": "PilotStrict",
        "StructuralWarnBelow": 0.85,
        "SemanticWarnBelow": 0.65,
        "StructuralRejectBelow": 0.7,
        "SemanticRejectBelow": 0.55,
        "PilotStrictMinStructuralCompleteness": 0.9,
        "PilotStrictMinSemanticScore": 0.55,
        "PilotStrictMinEvidenceRefCount": 2,
        "PilotStrictMinFaithfulnessSupportRatio": 0.65,
        "PilotStrictMinAgentResultFaithfulnessSupportRatio": 0.7,
        "HeuristicEvaluatorTightenedThresholds": true,
        "PerAgentTypeFloors": {
          "Topology": {
            "StructuralRejectBelow": 0.85,
            "SemanticRejectBelow": 0.65
          },
          "Compliance": {
            "StructuralRejectBelow": 0.8,
            "SemanticRejectBelow": 0.6
          },
          "Cost": {
            "StructuralRejectBelow": 0.75,
            "SemanticRejectBelow": 0.55
          },
          "Critic": {
            "StructuralRejectBelow": 0.65,
            "SemanticRejectBelow": 0.55
          }
        },
        "EnforceOnReject": true,
        "BlockRunOnReject": true,
        "PersistPartialOutputsOnBudgetExceeded": true,
        "MaxTokensPerRun": 2000000
      }
    },
    "QuickScan": {
      "Safety": {
        "Enabled": false,
        "AnonymousExecutionEnabled": false,
        "SampleFallbackEnabled": true,
        "EmergencyDisabled": false,
        "Models": {
          "ApprovedFallbackModelIds": [
            "gpt-4o-mini-sample"
          ]
        }
      }
    }
  },
  "AgentExecution": {
    "SchemaValidation": {
      "EnforceOnParse": true
    },
    "Resilience": {
      "LlmCallMaxRetryAttempts": 4,
      "LlmCallBaseDelayMilliseconds": 750,
      "LlmCallMaxDelaySeconds": 20
    }
  },
  "AzureOpenAI": {
    "CircuitBreaker": {
      "Completion": {
        "FailureThreshold": 8,
        "DurationOfBreakSeconds": 45,
        "HalfOpenSuccessThreshold": 2
      },
      "Embedding": {
        "FailureThreshold": 6,
        "DurationOfBreakSeconds": 30,
        "HalfOpenSuccessThreshold": 1
      }
    }
  },
  "DataConsistency": {
    "Enforcement": {
      "Mode": "Alert"
    }
  },
  "Retrieval": {
    "Reranking": {
      "Enabled": true
    },
    "Advanced": {
      "Enabled": false
    },
    "Ask": {
      "SkipExpensiveStages": false
    }
  },
  "DataArchival": {
    "Enabled": true,
    "RunsRetentionDays": 0,
    "DigestsRetentionDays": 0,
    "ConversationsRetentionDays": 0,
    "IntervalHours": 24,
    "PurgeUncommittedRunsAfterDays": 7,
    "PurgeUncommittedRunsBatchSize": 500,
    "BlobCleanup": {
      "Enabled": true,
      "MinAgeDays": 30
    }
  },
  "FeatureManagement": {
    "FeatureFlags": {
      "AsyncAuthorityPipeline": true
    }
  },
  "Integrations": {
    "Itsm": {
      "NativeEnabled": true
    }
  }
}

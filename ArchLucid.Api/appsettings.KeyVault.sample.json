{
  "_comment": "Copy values into Azure App Service / Container Apps application settings (not source control). Use Key Vault references so secrets never sit in git.",
  "ConnectionStrings": {
    "ArchLucid": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-sql-connection-string)"
  },
  "AzureOpenAI": {
    "AuthenticationMode": "ManagedIdentity",
    "ApiKey": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-azure-openai-api-key)",
    "Endpoint": "https://your-resource.openai.azure.com/",
    "DeploymentName": "gpt-5.6-terra",
    "MaxCompletionTokens": 4096,
    "EmbeddingDeploymentName": "your-embedding-deployment",
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "DurationOfBreakSeconds": 30
    }
  },
  "ArchLucid": {
    "FallbackLlm": {
      "Enabled": false,
      "Endpoints": [
        {
          "Endpoint": "https://your-fallback-resource.openai.azure.com/",
          "DeploymentName": "gpt-5.6-terra",
          "UseManagedIdentity": true
        }
      ]
    },
    "AgentModelTiers": {
      "DefaultTier": "Standard",
      "NonAgentDefaultTier": "Standard",
      "EconomyDeploymentName": "gpt-5.6-luna",
      "StandardDeploymentName": "gpt-5.6-terra",
      "PremiumDeploymentName": "gpt-5.6-sol"
    }
  },
  "AgentExecution": {
    "Mode": "Real",
    "LlmCostEstimation": {
      "Enabled": true,
      "InputUsdPerMillionTokens": 2.5,
      "OutputUsdPerMillionTokens": 15.0,
      "Deployments": {
        "gpt-5.6-luna": {
          "InputUsdPerMillionTokens": 1.0,
          "OutputUsdPerMillionTokens": 6.0
        },
        "gpt-5.6-terra": {
          "InputUsdPerMillionTokens": 2.5,
          "OutputUsdPerMillionTokens": 15.0
        },
        "gpt-5.6-sol": {
          "InputUsdPerMillionTokens": 5.0,
          "OutputUsdPerMillionTokens": 30.0
        }
      }
    }
  },
  "ArchLucidAuth": {
    "Mode": "ApiKey"
  },
  "Authentication": {
    "ApiKey": {
      "Enabled": true,
      "DevelopmentBypassAll": false,
      "AdminKey": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-api-admin-key)",
      "ReadOnlyKey": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-api-readonly-key)",
      "TenantId": "00000000-0000-0000-0000-000000000001",
      "WorkspaceId": "00000000-0000-0000-0000-000000000002",
      "ProjectId": "00000000-0000-0000-0000-000000000003"
    }
  },
  "AzureDevOps": {
    "Enabled": false,
    "ArchLucidApiKey": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-azuredevops-archlucid-api-key)"
  },
  "IntegrationEvents": {
    "ServiceBusFullyQualifiedNamespace": "your-namespace.servicebus.windows.net",
    "ServiceBusConnectionString": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-servicebus-connection-string)"
  },
  "WebhookDelivery": {
    "UseHttpClient": true,
    "HmacSha256SharedSecret": "@Microsoft.KeyVault(VaultName=your-key-vault-name;SecretName=archlucid-webhook-hmac-secret)"
  }
}

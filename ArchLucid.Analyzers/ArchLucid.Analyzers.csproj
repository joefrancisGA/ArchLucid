<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Code fixes need Microsoft.CodeAnalysis.Workspaces. RS1038 warns that workspaces are unavailable in CLI-only analyzer scenarios; IDE-only CodeFixProviders still reference it. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <AssemblyName>ArchLucid.Analyzers</AssemblyName>
    <RootNamespace>ArchLucid.Analyzers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArchLucid.Analyzers.Tests" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

</Project>

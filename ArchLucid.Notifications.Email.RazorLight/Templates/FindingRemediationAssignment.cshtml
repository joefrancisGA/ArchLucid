@model ArchLucid.Application.Notifications.Email.Models.FindingRemediationAssignmentEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
</head>
<body>
@if (!string.IsNullOrWhiteSpace(Model.LogoImageUrl))
{
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px 0;">
        <tr>
            <td>
                <img src="@Model.LogoImageUrl" alt="@Model.ProductName" width="96" height="96" style="display:block;width:96px;height:96px;border:0;"/>
            </td>
        </tr>
    </table>
}
<p>You were assigned remediation ownership for <strong>@Model.FindingTitle</strong>.</p>
@if (!string.IsNullOrWhiteSpace(Model.RemediationDueLabel))
{
    <p>Remediation due: <strong>@Model.RemediationDueLabel</strong></p>
}
<p><a href="@Model.FindingInspectUrl">Open the finding</a> · <a href="@Model.AssignedToQueueUrl">View your assigned findings</a></p>
</body>
</html>

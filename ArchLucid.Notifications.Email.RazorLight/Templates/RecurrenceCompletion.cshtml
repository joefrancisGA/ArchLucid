@model ArchLucid.Application.Notifications.Email.Models.RecurrenceCompletionEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
</head>
<body>
@if (!string.IsNullOrWhiteSpace(Model.LogoImageUrl))
{
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px 0;">
        <tr>
            <td>
                <img src="@Model.LogoImageUrl" alt="@Model.ProductName" width="96" height="96" style="display:block;width:96px;height:96px;border:0;"/>
            </td>
        </tr>
    </table>
}
<p>Your scheduled architecture review <strong>@Model.ScheduleName</strong> has finished.</p>
<p><strong>@Model.NewFindingCount</strong> new finding(s), <strong>@Model.ResolvedFindingCount</strong> resolved since the prior review.</p>
<p><a href="@Model.RunDetailUrl">Open the review</a> · <a href="@Model.CompareUrl">Compare with source run</a></p>
</body>
</html>

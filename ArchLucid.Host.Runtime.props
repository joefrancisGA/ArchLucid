<Project>
  <!-- TB-2161: zero-cost container runtime knobs (Api / Worker / Jobs.Cli). -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Declined: Microsoft.Data.SqlClient throws NotSupportedException under invariant globalization. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Softens Server GC heap floor on 1.0 Gi ACA API replicas. -->
    <GCConserveMemory>1</GCConserveMemory>
  </PropertyGroup>
</Project>

